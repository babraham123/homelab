# Appended to /etc/fstab on websvcs by hand (docs/guides/pve2_storage.md). Disks by
# stable id, so a changed SATA port order changes nothing; nofail so the VM boots with
# a disk missing, and snapraid's sync refuses to run until it is back.
{% for d in websvcs.media.disks -%}
/dev/disk/by-id/{{ d.id }}-part1  {{ d.mount }}  ext4  defaults,nofail,noatime  0  2
{% endfor -%}
# mergerfs union of the data disks. Options per the mergerfs quickstart for kernels
# >= 6.6; minfreespace keeps every disk from filling to the last byte, and moveonenospc
# moves a file to another disk when a write runs out of space on the one it landed on.
{{ websvcs.media.disks | map(attribute='mount') | reject('search', '^/mnt/parity') | join(':') }}  /srv/media  fuse.mergerfs  cache.files=off,category.create=pfrd,func.getattr=newest,minfreespace=50G,moveonenospc=true,fsname=media,nofail  0  0
