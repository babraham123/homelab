#!/bin/bash
# Usage:
#   src/nodes/websvcs/commands.sh CMD

# shellcheck source=src/base/lib.sh
source "$(dirname "${BASH_SOURCE[0]}")/../../base/lib.sh"
export PATH=/usr/sbin:/usr/bin:/sbin:/bin

# The install_* commands take their files on stdin, bundled by send_files.sh.
case $1 in
  install_certs)
    receive_files webproxy.{{ site.url }}.cert.pem webproxy.{{ site.url }}.client_cert.pem \
      appsec-websvcs.{{ site.url }}.client_cert.pem ca-chain.cert.pem
    mkdir -p /etc/opt/traefik/certificates
    mkdir -p /etc/opt/guacamole/certs
    mkdir -p /etc/opt/crowdsec_appsec/certificates

    mv webproxy.{{ site.url }}.cert.pem /etc/opt/traefik/certificates/proxy.crt
    mv webproxy.{{ site.url }}.client_cert.pem /etc/opt/traefik/certificates/proxy.client.crt
    mv appsec-websvcs.{{ site.url }}.client_cert.pem /etc/opt/crowdsec_appsec/certificates/appsec.cert.pem

    cp ca-chain.cert.pem /etc/opt/traefik/certificates/ca.chain.crt
    cp ca-chain.cert.pem /etc/opt/guacamole/certs/ca.chain.pem
    cp ca-chain.cert.pem /etc/opt/crowdsec_appsec/certificates/ca.chain.pem
    ;;
  install_keys)
    receive_files webproxy.{{ site.url }}.key.pem appsec-websvcs.{{ site.url }}.key.pem
    mkdir -p /etc/opt/traefik/certificates
    mkdir -p /etc/opt/crowdsec_appsec/certificates

    mv webproxy.{{ site.url }}.key.pem /etc/opt/traefik/certificates/proxy.key
    mv appsec-websvcs.{{ site.url }}.key.pem /etc/opt/crowdsec_appsec/certificates/appsec.key.pem
    ;;
  *)
    die "unknown file type: $1"
    ;;
esac
