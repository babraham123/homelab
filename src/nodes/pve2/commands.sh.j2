#!/bin/bash
# Usage:
#   src/nodes/pve2/commands.sh CMD

# shellcheck source=src/base/lib.sh
source "$(dirname "${BASH_SOURCE[0]}")/../../base/lib.sh"
export PATH=/usr/sbin:/usr/bin:/sbin:/bin

# Usage: switch_gpu_vm FROM TO; devtop and gaming share the GPU, so one stops before the
# other starts. A guest that ignores the shutdown is stopped after 30 s.
switch_gpu_vm() {
  local from to
  from=$("${rendered}/nodes/pve2/get_vm_id.sh" "$1")
  to=$("${rendered}/nodes/pve2/get_vm_id.sh" "$2")
  if vm_running "$from"; then
    qm shutdown "$from" --timeout 30 --forceStop 1
  fi
  # Still booting from an earlier call
  if ! vm_running "$to"; then
    qm start "$to" --timeout 30
  fi
}

vm_running() {
  [[ $(qm status "$1") == "status: running" ]]
}

case $1 in
  start_gaming_vm)
    ping -c1 -W1 {{ gaming.ip }} && exit 0
    switch_gpu_vm devtop gaming
    # Poll until the guest is reachable so callers that chain an SSH command into
    # it don't race the OS boot (sshd/scheduled tasks aren't up yet).
    for _ in $(seq 1 60); do
      ping -c1 -W1 {{ gaming.ip }} &>/dev/null && break
      sleep 5
    done
    # Give sshd and the SSH-trigger watcher scheduled task a moment to come
    # up after the network stack is reachable.
    sleep 10
    ;;
  # The hookscript must live on a storage with snippets content, so it is a copy;
  # this refreshes it and (re)attaches it to the two GPU VMs.
  install_hookscript)
    mkdir -p /var/lib/vz/snippets
    cp "${rendered}/nodes/pve2/hookscript.pl" /var/lib/vz/snippets/hookscript.pl
    for vm in devtop gaming; do
      qm set "$("${rendered}/nodes/pve2/get_vm_id.sh" "$vm")" --hookscript local:snippets/hookscript.pl
    done
    ;;
  stop_gaming_vm)
    switch_gpu_vm gaming devtop
    ;;
  install_certs_and_keys)
    # Takes the certificates on stdin (send_files.sh), moves them into their respective
    # locations and restarts the services. Also configures the PBS cert fingerprint.
    receive_files pveproxy-ssl.pem pveproxy-ssl.key proxy.pem proxy.key
    cp pveproxy-ssl.* /etc/pve/nodes/pve2/
    # Ref: https://forum.proxmox.com/threads/proxmox-backup-tailscale-proxmox-backup-proxy-service-wont-boot.153204/
    cp proxy.* /etc/proxmox-backup/

    systemctl restart pveproxy.service
    systemctl reload proxmox-backup-proxy.service

    # Update PBS fingerprint for PVE2
    # Ref: https://pbs.proxmox.com/docs/pve-integration.html
    fingerprint=$(proxmox-backup-manager cert info | grep "Fingerprint" | sed -r 's/Fingerprint\s+\(sha256\):\s+([a-f0-9:]+)/\1/')
    pvesm set pbs2 --fingerprint "$fingerprint"

    # Print out the fingerprint for PVE1
    echo "$fingerprint"
    ;;
  *)
    die "unknown command: $1"
    ;;
esac
