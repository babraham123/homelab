#!/bin/bash
# Generate self-signed certificates and distribute them to the secsvcs, websvcs and homesvcs servers.
# Usage:
#   /root/homelab-rendered/src/nodes/pve1/certificates/self_signed_cert_gen.sh

# shellcheck source=src/base/lib.sh
source "$(dirname "${BASH_SOURCE[0]}")/../../../base/lib.sh"

# site.name is free text: backslash-escaped for -subj, where / and + separate fields,
# then shell-quoted once here rather than inside each -subj.
org={{ site.name | replace("\\", "\\\\") | replace("/", "\\/") | replace("+", "\\+") | quote }}
subj="/C={{ personal.country_code }}/ST={{ personal.state }}/L={{ personal.city }}/O=${org}"

require_root
require_reachable secsvcs websvcs homesvcs

send="${rendered}/base/debian/send_files.sh"
cd /root/ca/intermediate
# Ref: https://zsh.sourceforge.io/Doc/Release/Shell-Builtin-Commands.html#:~:text=fc%20%2De%20%2D.-,read,-%5B%20%2DrszpqAclneE%20%5D%20%5B
echo -n 'Enter intermediate CA passphrase: '
read -r -s CA_PASS
# env:, not pass:, keeps the passphrase out of argv, which `ps` shows to every user
export CA_PASS

openssl req -config openssl.cnf \
  -key private/wildcard.{{ site.url }}.key.pem \
  -subj "${subj}/OU=svcs/CN=*.{{ site.url }}" \
  -addext 'subjectAltName = DNS:*.{{ site.url }},DNS:{{ site.url }}' \
  -new -sha256 -out csr/wildcard.{{ site.url }}.csr.pem
openssl ca -config openssl.cnf -passin env:CA_PASS \
  -extensions server_cert -days 395 -notext -md sha256 \
  -in csr/wildcard.{{ site.url }}.csr.pem \
  -out certs/wildcard.{{ site.url }}.cert.pem
chmod 444 certs/wildcard.{{ site.url }}.cert.pem

openssl req -config openssl.cnf \
  -key private/ldap.{{ site.url }}.key.pem \
  -subj "${subj}/OU=secsvcs/CN=ldap.{{ site.url }}" \
  -addext 'subjectAltName = DNS:ldap.{{ site.url }}' \
  -new -sha256 -out csr/ldap.{{ site.url }}.csr.pem
openssl ca -config openssl.cnf -passin env:CA_PASS \
  -extensions server_cert -days 395 -notext -md sha256 \
  -in csr/ldap.{{ site.url }}.csr.pem \
  -out certs/ldap.{{ site.url }}.cert.pem
chmod 444 certs/ldap.{{ site.url }}.cert.pem

openssl req -config openssl.cnf \
  -key private/auth.{{ site.url }}.key.pem \
  -subj "${subj}/OU=secsvcs/CN=auth.{{ site.url }}" \
  -addext 'subjectAltName = DNS:auth.{{ site.url }}' \
  -new -sha256 -out csr/auth.{{ site.url }}.csr.pem
openssl ca -config openssl.cnf -passin env:CA_PASS \
  -extensions server_cert -days 395 -notext -md sha256 \
  -in csr/auth.{{ site.url }}.csr.pem \
  -out certs/auth.{{ site.url }}.cert.pem
chmod 444 certs/auth.{{ site.url }}.cert.pem

openssl req -config openssl.cnf \
  -key private/pgdb.{{ site.url }}.key.pem \
  -subj "${subj}/OU=secsvcs/CN=pgdb.{{ site.url }}" \
  -addext 'subjectAltName = DNS:pgdb.{{ site.url }}' \
  -new -sha256 -out csr/pgdb.{{ site.url }}.csr.pem
openssl ca -config openssl.cnf -passin env:CA_PASS \
  -extensions server_cert -days 395 -notext -md sha256 \
  -in csr/pgdb.{{ site.url }}.csr.pem \
  -out certs/pgdb.{{ site.url }}.cert.pem
chmod 444 certs/pgdb.{{ site.url }}.cert.pem

openssl req -config openssl.cnf \
  -key private/secproxy.{{ site.url }}.key.pem \
  -subj "${subj}/OU=secsvcs/CN=secproxy.{{ site.url }}" \
  -addext 'subjectAltName = DNS:secproxy.{{ site.url }}' \
  -new -sha256 -out csr/secproxy.{{ site.url }}.csr.pem
openssl ca -config openssl.cnf -passin env:CA_PASS \
  -extensions server_cert -days 395 -notext -md sha256 \
  -in csr/secproxy.{{ site.url }}.csr.pem \
  -out certs/secproxy.{{ site.url }}.cert.pem
chmod 444 certs/secproxy.{{ site.url }}.cert.pem

openssl ca -config openssl.cnf -passin env:CA_PASS \
  -extensions usr_cert -days 395 -notext -md sha256 \
  -in csr/secproxy.{{ site.url }}.csr.pem \
  -out certs/secproxy.{{ site.url }}.client_cert.pem
chmod 444 certs/secproxy.{{ site.url }}.client_cert.pem

# CrowdSec's LAPI, a published port on secsvcs that the VPS's bouncer reaches over the
# tailnet
openssl req -config openssl.cnf \
  -key private/crowdsec.{{ site.url }}.key.pem \
  -subj "${subj}/OU=secsvcs/CN=crowdsec.{{ site.url }}" \
  -addext 'subjectAltName = DNS:crowdsec.{{ site.url }}' \
  -new -sha256 -out csr/crowdsec.{{ site.url }}.csr.pem
openssl ca -config openssl.cnf -passin env:CA_PASS \
  -extensions server_cert -days 395 -notext -md sha256 \
  -in csr/crowdsec.{{ site.url }}.csr.pem \
  -out certs/crowdsec.{{ site.url }}.cert.pem
chmod 444 certs/crowdsec.{{ site.url }}.cert.pem

# Each node's CrowdSec AppSec logs in to the LAPI with a client certificate: the LAPI
# accepts OU=agent-ou as an agent and names the machine after the CN
{% for node in ['secsvcs', 'homesvcs', 'websvcs'] -%}
openssl req -config openssl.cnf \
  -key private/appsec-{{ node }}.{{ site.url }}.key.pem \
  -subj "${subj}/OU=agent-ou/CN=appsec-{{ node }}" \
  -new -sha256 -out csr/appsec-{{ node }}.{{ site.url }}.csr.pem
openssl ca -config openssl.cnf -passin env:CA_PASS \
  -extensions usr_cert -days 395 -notext -md sha256 \
  -in csr/appsec-{{ node }}.{{ site.url }}.csr.pem \
  -out certs/appsec-{{ node }}.{{ site.url }}.client_cert.pem
chmod 444 certs/appsec-{{ node }}.{{ site.url }}.client_cert.pem
{% endfor %}
openssl req -config openssl.cnf \
  -key private/webproxy.{{ site.url }}.key.pem \
  -subj "${subj}/OU=websvcs/CN=webproxy.{{ site.url }}" \
  -addext 'subjectAltName = DNS:webproxy.{{ site.url }}' \
  -new -sha256 -out csr/webproxy.{{ site.url }}.csr.pem
openssl ca -config openssl.cnf -passin env:CA_PASS \
  -extensions server_cert -days 395 -notext -md sha256 \
  -in csr/webproxy.{{ site.url }}.csr.pem \
  -out certs/webproxy.{{ site.url }}.cert.pem
chmod 444 certs/webproxy.{{ site.url }}.cert.pem

openssl ca -config openssl.cnf -passin env:CA_PASS \
  -extensions usr_cert -days 395 -notext -md sha256 \
  -in csr/webproxy.{{ site.url }}.csr.pem \
  -out certs/webproxy.{{ site.url }}.client_cert.pem
chmod 444 certs/webproxy.{{ site.url }}.client_cert.pem

openssl req -config openssl.cnf \
  -key private/homeproxy.{{ site.url }}.key.pem \
  -subj "${subj}/OU=homesvcs/CN=homeproxy.{{ site.url }}" \
  -addext 'subjectAltName = DNS:homeproxy.{{ site.url }}' \
  -new -sha256 -out csr/homeproxy.{{ site.url }}.csr.pem
openssl ca -config openssl.cnf -passin env:CA_PASS \
  -extensions server_cert -days 395 -notext -md sha256 \
  -in csr/homeproxy.{{ site.url }}.csr.pem \
  -out certs/homeproxy.{{ site.url }}.cert.pem
chmod 444 certs/homeproxy.{{ site.url }}.cert.pem

openssl ca -config openssl.cnf -passin env:CA_PASS \
  -extensions usr_cert -days 395 -notext -md sha256 \
  -in csr/homeproxy.{{ site.url }}.csr.pem \
  -out certs/homeproxy.{{ site.url }}.client_cert.pem
chmod 444 certs/homeproxy.{{ site.url }}.client_cert.pem

openssl req -config openssl.cnf \
  -key private/mqtt.{{ site.url }}.key.pem \
  -subj "${subj}/OU=homesvcs/CN=mqtt.{{ site.url }}" \
  -addext 'subjectAltName = DNS:mqtt.{{ site.url }}' \
  -new -sha256 -out csr/mqtt.{{ site.url }}.csr.pem
openssl ca -config openssl.cnf -passin env:CA_PASS \
  -extensions server_cert -days 395 -notext -md sha256 \
  -in csr/mqtt.{{ site.url }}.csr.pem \
  -out certs/mqtt.{{ site.url }}.cert.pem
chmod 444 certs/mqtt.{{ site.url }}.cert.pem

openssl req -config openssl.cnf \
  -key private/zigbee.{{ site.url }}.key.pem \
  -subj "${subj}/OU=homesvcs/CN=zigbee.{{ site.url }}" \
  -addext 'subjectAltName = DNS:zigbee.{{ site.url }}' \
  -new -sha256 -out csr/zigbee.{{ site.url }}.csr.pem
openssl ca -config openssl.cnf -passin env:CA_PASS \
  -extensions usr_cert -days 395 -notext -md sha256 \
  -in csr/zigbee.{{ site.url }}.csr.pem \
  -out certs/zigbee.{{ site.url }}.client_cert.pem
chmod 444 certs/zigbee.{{ site.url }}.client_cert.pem

openssl req -config openssl.cnf \
  -key private/home.{{ site.url }}.key.pem \
  -subj "${subj}/OU=homesvcs/CN=home.{{ site.url }}" \
  -addext 'subjectAltName = DNS:home.{{ site.url }}' \
  -new -sha256 -out csr/home.{{ site.url }}.csr.pem
openssl ca -config openssl.cnf -passin env:CA_PASS \
  -extensions usr_cert -days 395 -notext -md sha256 \
  -in csr/home.{{ site.url }}.csr.pem \
  -out certs/home.{{ site.url }}.client_cert.pem
chmod 444 certs/home.{{ site.url }}.client_cert.pem

unset CA_PASS

# Each node's files go on its install command's stdin
"$send" \
  certs/ldap.{{ site.url }}.cert.pem \
  certs/auth.{{ site.url }}.cert.pem \
  certs/pgdb.{{ site.url }}.cert.pem \
  certs/secproxy.{{ site.url }}.cert.pem \
  certs/secproxy.{{ site.url }}.client_cert.pem \
  certs/webproxy.{{ site.url }}.client_cert.pem \
  certs/homeproxy.{{ site.url }}.client_cert.pem \
  certs/crowdsec.{{ site.url }}.cert.pem \
  certs/appsec-secsvcs.{{ site.url }}.client_cert.pem \
  certs/ca-chain.cert.pem |
  ssh autoadmin@secsvcs install_certs
"$send" \
  certs/webproxy.{{ site.url }}.cert.pem \
  certs/webproxy.{{ site.url }}.client_cert.pem \
  certs/appsec-websvcs.{{ site.url }}.client_cert.pem \
  certs/ca-chain.cert.pem |
  ssh autoadmin@websvcs install_certs
"$send" \
  certs/homeproxy.{{ site.url }}.cert.pem \
  certs/homeproxy.{{ site.url }}.client_cert.pem \
  certs/mqtt.{{ site.url }}.cert.pem \
  certs/zigbee.{{ site.url }}.client_cert.pem \
  certs/home.{{ site.url }}.client_cert.pem \
  certs/appsec-homesvcs.{{ site.url }}.client_cert.pem \
  certs/ca-chain.cert.pem |
  ssh autoadmin@homesvcs install_certs

date -u > /root/ca/date_self_signed_certs.txt
echo -e '\nMake sure to restart all secure services'
