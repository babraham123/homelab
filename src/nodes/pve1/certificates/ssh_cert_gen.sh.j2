{% set others = inv.nodes_with.install_ssh_ca | reject('eq', 'pve1') | join(' ') -%}
#!/bin/bash
# Generate SSH certificates and distribute them to all servers.
# Usage:
#   /root/homelab-rendered/src/nodes/pve1/certificates/ssh_cert_gen.sh

# shellcheck source=src/base/lib.sh
source "$(dirname "${BASH_SOURCE[0]}")/../../../base/lib.sh"

require_root
require_reachable {{ others }} router

# Files go to the nodes on the install commands' stdin
send="${rendered}/base/debian/send_files.sh"
cd /root/ssh

echo "@cert-authority *.{{ site.url }} $(cat ca_ssh_host_key.pub)" > known_hosts
chmod 644 known_hosts

function configure_server() {
  host=$1
  principals="${host}.{{ site.url }}"
  if [[ "$host" == "vpnsvcs" ]]; then
    # vpn.{{ site.url }} is the Headscale endpoint on the same box; callers still use it
    principals+=",vpn.{{ site.url }}"
  fi
  echo "Configuring SSH CA for ${host}"
  # Over the authenticated session, not ssh-keyscan: a key read off the wire could be
  # anyone's, and this one gets signed
  ssh "autoadmin@${host}" host_key > "public/${host}.ssh_host_key.pub"
  addr=$(dig "${host}.{{ site.url }}" +short)
  ssh-keygen -s ca_ssh_host_key -I "$host" -h -n "${principals},${addr}" -V +395d "public/${host}.ssh_host_key.pub"
  chmod 444 "public/${host}.ssh_host_key-cert.pub"

  "$send" ca_ssh_key.pub known_hosts "public/${host}.ssh_host_key-cert.pub=ssh_host_key_cert.pub" | \
    ssh "autoadmin@${host}" install_ssh_ca
}

# First: its install_ssh_ca puts src/base/debian/ssh_config on pve1, which is where this
# script's ssh finds vpnsvcs's port
configure_server pve1
for node in {{ others }}; do
  configure_server "$node"
done

# router
ssh -M -S ~/.ssh/ssh-socket-%r-%h-%p -f -N admin@router
function scpsoc() { scp -o ControlPath=~/.ssh/ssh-socket-%r-%h-%p "$@"; }

scpsoc ca_ssh_key.pub admin@router:/etc/ssh
scpsoc admin@router:/etc/ssh/ssh_host_ed25519_key.pub public/router.ssh_host_key.pub
addrs="router.{{ site.url }},{{ lan.subnet }}.1,{{ pve1.subnet }}.1,{{ pve2.subnet }}.1"
ssh-keygen -s ca_ssh_host_key -I router -h -n "$addrs" -V +395d public/router.ssh_host_key.pub
chmod 444 public/router.ssh_host_key-cert.pub
scpsoc public/router.ssh_host_key-cert.pub admin@router:/etc/ssh/ssh_host_key_cert.pub
scpsoc known_hosts admin@router:/etc/ssh/ssh_known_hosts

ssh -S ~/.ssh/ssh-socket-%r-%h-%p -O exit admin@router

# SSH clients

function request_cmd() {
  echo "Run the following command on your local machine:"
  echo "$1"
  read -p "Press any key when done: " -n 1 -r
  echo -e "\n"
}

# pve1
ssh-keygen -s ca_ssh_key -I "pve1" -n "manualadmin,autoadmin" -V +395d /root/.ssh/id_ed25519.pub
chmod 644 /root/.ssh/id_ed25519-cert.pub

# Olive Tin
ssh-keygen -t ed25519 -C "olive_tin@command.{{ site.url }}" -f /root/ssh/id_ed25519 -N ""
ssh-keygen -s ca_ssh_key -I "olive_tin" -n "autoadmin" -V +395d id_ed25519.pub
chmod 644 id_ed25519*.pub
chmod 600 id_ed25519
"$send" id_ed25519 id_ed25519.pub id_ed25519-cert.pub known_hosts | \
  ssh autoadmin@secsvcs install_olive_tin_cert
rm id_ed25519*

# local machine, through manualadmin's home: autoadmin takes no files
request_cmd "scp ~/.ssh/id_ed25519.pub manualadmin@pve1:local.id_ed25519.pub"
ssh-keygen -s ca_ssh_key -I "local" -n "manualadmin,autoadmin" -V +395d /home/manualadmin/local.id_ed25519.pub
chmod 644 /home/manualadmin/local.id_ed25519-cert.pub
request_cmd "scp manualadmin@pve1:local.id_ed25519-cert.pub ~/.ssh/id_ed25519-cert.pub"
rm /home/manualadmin/local.id_ed25519*

echo "Edit ~/.ssh/known_hosts on your local machine to include the following line:"
cat known_hosts

date -u > /root/ssh/date_ssh_certs.txt
