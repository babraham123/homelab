# Proxmox VM settings (qm config) as a reference; IDs, MACs, UUIDs and PCI/USB addresses are placeholders
agent: 1
bios: ovmf
boot: order=scsi0;net0
cores: 1
cpu: host
efidisk0: local-lvm:vm-VMID-disk-0,efitype=4m,pre-enrolled-keys=1,size=4M
machine: q35
memory: 8192
name: homesvcs
net0: virtio=MAC_ADDR,bridge=vmbr0,firewall=1
numa: 0
onboot: 1
ostype: l26
scsi0: local-lvm:vm-VMID-disk-1,discard=on,iothread=1,size=96G,ssd=1
scsihw: virtio-scsi-single
sockets: 1
startup: order=2,up=30
