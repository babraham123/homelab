#!/bin/bash
# Installs VPN specific systemd services.
# Usage:
#   src/nodes/vpnsvcs/install_svcs.sh SERVICE_NAME

# shellcheck source=src/base/lib.sh
source "$(dirname "${BASH_SOURCE[0]}")/../../base/lib.sh"

cd "$rendered"
watch_homelab_units

# Every image the case's quadlets name is downloaded (or built) and passes the scan gate
# before any quadlet is copied; a blocked image stops the install here.
/usr/local/bin/image_updater install "${1:?usage: $0 SERVICE_NAME}"

# HAProxy, Headscale and the CrowdSec bouncer serve metrics on the podman bridge gateway
# (net.network)
nonlocal_bind() {
  install -D -m 644 nodes/vpnsvcs/nonlocal_bind.conf /etc/sysctl.d/90-homelab-nonlocal-bind.conf
  sysctl -p /etc/sysctl.d/90-homelab-nonlocal-bind.conf
}

case $1 in
  headscale)
    # sqlite3 takes the consistent DB snapshot for backup.sh
    apt install -y sqlite3
    nonlocal_bind
    # The minor is fixed: a minor release can change the config and policy format
    version=$(github_latest_patch juanfont/headscale 0.29)
    deb="headscale_${version}_linux_amd64.deb"
    url="https://github.com/juanfont/headscale/releases/download/v${version}"
    wget "$url/$deb" "$url/checksums.txt"
    sha256sum --check --ignore-missing checksums.txt || die "checksum mismatch: $deb"
    dpkg --install "$deb"
    rm "$deb" checksums.txt
    base/debian/add_homelab_tag.sh headscale.service
    install -D -m 644 services/headscale/headscale.yaml /etc/headscale/config.yaml
    install -D -m 644 services/headscale/headscale_acl.hujson /etc/headscale/acl.hujson
    touch /etc/opt/secrets/hs_oidc_id
    oidc_id=$(cat /etc/opt/secrets/hs_oidc_id | tr -d '\n')
    sed -i "s/PLACEHOLDER_ID/$oidc_id/g" /etc/headscale/config.yaml
    systemctl enable headscale
    reload_restart headscale
    ;;
  tailscaled)
    curl -fsSL https://pkgs.tailscale.com/stable/debian/trixie.noarmor.gpg | sudo tee /usr/share/keyrings/tailscale-archive-keyring.gpg >/dev/null
    curl -fsSL https://pkgs.tailscale.com/stable/debian/trixie.tailscale-keyring.list | sudo tee /etc/apt/sources.list.d/tailscale.list
    sudo apt update
    sudo apt install -y tailscale
    base/debian/add_homelab_tag.sh tailscaled.service
    systemctl enable tailscaled
    reload_restart tailscaled
    ;;
  haproxy)
    apt install -y haproxy
    nonlocal_bind
    base/debian/add_homelab_tag.sh haproxy.service
    # The files haproxy.cfg references must exist before it's checked
    curl https://ssl-config.mozilla.org/ffdhe2048.txt > /etc/haproxy/dhparam
    mkdir -p /etc/haproxy/countries
{% for country in site.blocked_countries %}
    touch /etc/haproxy/countries/{{ country }}.map
    chmod 644 /etc/haproxy/countries/{{ country }}.map{% endfor %}
    haproxy -c -f services/haproxy/haproxy.cfg || die "invalid haproxy.cfg, /etc/haproxy/haproxy.cfg left as is"
    install -D -m 644 -t /etc/haproxy services/haproxy/haproxy.cfg
    systemctl enable haproxy
    reload_restart haproxy
    ;;
  fail2ban)
    apt install -y fail2ban python3-systemd
    install -D -m 644 -t /etc/fail2ban nodes/vpnsvcs/fail2ban.local nodes/vpnsvcs/jail.local
    base/debian/add_homelab_tag.sh fail2ban.service
    systemctl enable fail2ban
    reload_restart fail2ban
    # The server opens its socket a moment after systemd reports it started
    wait_for 30 "fail2ban socket" fail2ban-client ping
    fail2ban-client status
    ;;
  crowdsec_firewall_bouncer)
    # CrowdSec's apt repo, trusted only if its signing key has the fingerprint pinned here
    apt install -y gpg
    key=$(mktemp)
    curl -fsSL https://packagecloud.io/crowdsec/crowdsec/gpgkey -o "$key"
    fpr=$(gpg --show-keys --with-colons "$key" | awk -F: '$1 == "fpr" { print $10; exit }')
    [[ $fpr == 6A89E3C2303A901A889971D3376ED5326E93CD0C ]] || die "unexpected CrowdSec repo key: ${fpr}"
    install -d -m 755 /etc/apt/keyrings
    gpg --dearmor --yes -o /etc/apt/keyrings/crowdsec.gpg "$key"
    rm "$key"
    echo "deb [signed-by=/etc/apt/keyrings/crowdsec.gpg] https://packagecloud.io/crowdsec/crowdsec/any/ any main" \
      > /etc/apt/sources.list.d/crowdsec.list
    apt update
    apt install -y crowdsec-firewall-bouncer-nftables
    nonlocal_bind
    conf=/etc/crowdsec/bouncers/crowdsec-firewall-bouncer.yaml.local
    install -D -m 600 services/crowdsec/crowdsec-firewall-bouncer.yaml.local "$conf"
    # The key is the LAPI's crowdsec_bouncer_vpnsvcs secret on secsvcs
    key=$(tr -d '\n' < /etc/opt/secrets/crowdsec_bouncer_key)
    [[ -n $key ]] || die "/etc/opt/secrets/crowdsec_bouncer_key is empty"
    sed -i "s/PLACEHOLDER_KEY/${key}/" "$conf"
    base/debian/add_homelab_tag.sh crowdsec-firewall-bouncer.service
    systemctl enable crowdsec-firewall-bouncer
    reload_restart crowdsec-firewall-bouncer
    ;;
  geoip_generator)
    install_quadlet services/geoip_generator/geoip_generator.container
    install -D -m 644 -t /etc/systemd/system services/geoip_generator/geoip_generator.timer
    systemctl daemon-reload
    systemctl enable geoip_generator.timer
    systemctl restart geoip_generator.timer
    ;;
  deadman)
    install -d -m 700 /var/lib/deadman
    install -D -m 644 -t /etc/systemd/system nodes/vpnsvcs/deadman.{service,timer}

    systemctl daemon-reload
    systemctl enable deadman.timer
    systemctl restart deadman.timer
    ;;
  *)
    die "unknown service: $1"
    ;;
esac
