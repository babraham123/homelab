# /etc/opt/vmagent/prometheus.yml
# Ref: https://prometheus.io/docs/prometheus/latest/configuration/configuration
# Every target carries a `host` label (the node, no port): ntfy-alertmanager tags pushes
# by it, and it stays the same for every job on a node. Host services listen on the
# podman bridge gateway, {{ vpnsvcs.container_subnet }}.1, with ufw allowing only vmagent.
---
global:
  scrape_interval: 10s

scrape_configs:
  - job_name: 'vmagent'
    static_configs:
      - targets: ['metric-collector.{{ site.url }}:8429']
    metrics_path: /metrics
    relabel_configs: &host
      - target_label: host
        replacement: vpnsvcs
  - job_name: 'fluentbit'
    static_configs:
      - targets: ['log-collector.{{ site.url }}:2020']
    metrics_path: /api/v1/metrics/prometheus
    relabel_configs: *host
  - job_name: 'haproxy'
    # The built-in exporter (src/services/haproxy/haproxy.cfg.j2)
    static_configs:
      - targets: ['{{ vpnsvcs.container_subnet }}.1:8405']
    metrics_path: /metrics
    relabel_configs:
      - target_label: instance
        replacement: vpnsvcs.{{ site.url }}:8405
      - target_label: host
        replacement: vpnsvcs
  - job_name: 'headscale'
    # metrics_listen_addr in src/services/headscale/headscale.yaml.j2
    static_configs:
      - targets: ['{{ vpnsvcs.container_subnet }}.1:9090']
    metrics_path: /metrics
    relabel_configs:
      - target_label: instance
        replacement: vpnsvcs.{{ site.url }}:9090
      - target_label: host
        replacement: vpnsvcs
  - job_name: 'tailscaled'
    # Client metrics, tailscale >= 1.78: https://tailscale.com/kb/1482/client-metrics.
    # Routed out tailscale0 from the container; tailscaled answers it like a local request.
    static_configs:
      - targets: ['100.100.100.100:80']
    metrics_path: /metrics
    relabel_configs:
      - target_label: instance
        replacement: vpnsvcs.{{ site.url }}:tailscaled
      - target_label: host
        replacement: vpnsvcs
  - job_name: 'node_exporter'
    static_configs:
      - targets: ['{{ vpnsvcs.container_subnet }}.1:9100']
    metrics_path: /metrics
    relabel_configs:
      - target_label: instance
        replacement: vpnsvcs.{{ site.url }}:9100
      - target_label: host
        replacement: vpnsvcs
...
