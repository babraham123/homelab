# /etc/opt/traefik/config/dynamic/routes.yml
# References:
#   - https://www.authelia.com/integration/proxies/traefik/
#   - https://www.simplecto.com/use-traefik-with-nginx-apache-caddyserver-serve-static-files/
#   - https://doc.traefik.io/traefik/reference/dynamic-configuration/file/
#   - https://doc.traefik.io/traefik/routing/routers/#priority
#   - https://doc.traefik.io/traefik/reference/routing-configuration/http/routing/multi-layer-routing/
# yamllint disable rule:document-start rule:document-end
{#
  Browser UI of a telemetry tool whose own auth is a shared admin login. The parent
  authenticates; its children then match on the Remote-Groups header ForwardAuth set
  (Traefik deletes any client-sent copy first), so only the telemetry_access group gets the
  injected admin credentials and everyone else gets the 403 page.
#}
{%- macro telemetry_ui(name, rule, service, auth) %}
    {{ name }}-ui:
      rule: {{ rule }}
      entryPoints: websecure
      middlewares:
        - authelia@file
        - secure-headers@file
      tls:
        options: intermediate@file
        certResolver: le-http-production
    {{ name }}-ui-telemetry:
      parentRefs: [{{ name }}-ui]
      # Authelia joins groups with a bare comma
      rule: HeaderRegexp(`Remote-Groups`, `(^|,)telemetry_access(,|$)`)
      service: {{ service }}@file
      middlewares:
        - {{ auth }}@file
    {{ name }}-ui-denied:
      parentRefs: [{{ name }}-ui]
      rule: PathPrefix(`/`)
      priority: 1
      service: s403@file
{%- endmacro -%}
http:
  routers:
    traefik: &service
      rule: Host(`secproxy.{{ site.url }}`)
      entryPoints: websecure
      service: api@internal
      middlewares:
        - authelia@file
        - secure-headers@file
      tls:
        options: intermediate@file
        certResolver: le-http-production
    authelia:
      <<: *service
      rule: Host(`auth.{{ site.url }}`)
      service: authelia@file
      middlewares:
        - secure-headers@file
    lldap:
      <<: *service
      rule: Host(`ldap.{{ site.url }}`)
      service: lldap@file
    gatus:
      <<: *service
      rule: Host(`uptime.{{ site.url }}`)
      service: gatus@file
    grafana:
      <<: *service
      rule: Host(`graph.{{ site.url }}`)
      service: grafana@file
{{- telemetry_ui('victoriametrics', 'Host(`metrics.' ~ site.url ~ '`) && HeaderRegexp(`User-Agent`, `^Mozilla\/.*`)', 'victoriametrics', 'vm-auth') }}
    victoriametrics-hass-api:
      <<: *service
      rule: Host(`metrics.{{ site.url }}`) && HeaderRegexp(`Authorization`, `^Token .+$`)
      service: victoriametrics@file
      middlewares:
        - "vm-auth-token@file"
    victoriametrics-api:
      <<: *service
      rule: Host(`metrics.{{ site.url }}`)
      service: victoriametrics@file
      middlewares: []
{{- telemetry_ui('victorialogs', 'Host(`logs.' ~ site.url ~ '`) && HeaderRegexp(`User-Agent`, `^Mozilla\/.*`)', 'victorialogs', 'vl-auth') }}
    victorialogs-api:
      <<: *service
      rule: Host(`logs.{{ site.url }}`)
      service: victorialogs@file
      middlewares: []
    vmalert:
      <<: *service
      rule: Host(`vmalert.{{ site.url }}`)
      service: vmalert@file
{{- telemetry_ui('alertmanager', 'Host(`alert.' ~ site.url ~ '`) && HeaderRegexp(`User-Agent`, `^Mozilla\/.*`)', 'alertmanager', 'alertmanager-auth') }}
    alertmanager-api:
      <<: *service
      rule: Host(`alert.{{ site.url }}`)
      service: alertmanager@file
      middlewares: []
    # Browser navigations only, where Authelia's redirect works. The web app signs in to ntfy
    # itself, so its fetch, WebSocket and service-worker requests go to ntfy-api with their own
    # credentials. The redeem page carries its code in the fragment, which Authelia's post-login
    # redirect would drop.
    ntfy-ui:
      <<: *service
      rule: Host(`push.{{ site.url }}`) && Method(`GET`) && Header(`Sec-Fetch-Mode`, `navigate`) && !PathPrefix(`/file/`) && !Path(`/account/token/redeem`)
      service: ntfy@file
    # The signed-in web app sends its token as ?auth= on the WebSocket URL
    ntfy-ws:
      <<: *service
      rule: Host(`push.{{ site.url }}`) && PathRegexp(`^/[-_A-Za-z0-9,]+/ws$`)
      service: ntfy@file
      middlewares: []
      observability:
        accessLogs: false
    ntfy-api:
      <<: *service
      rule: Host(`push.{{ site.url }}`)
      service: ntfy@file
      middlewares: []
    ntfy-alertmanager:
      <<: *service
      rule: Host(`ntfy-alertmanager.{{ site.url }}`)
      service: ntfy-alertmanager@file
      middlewares: []
    # Clients call the API directly, so no Authelia. No secure-headers either: it would replace
    # Vaultwarden's own CSP and X-Frame-Options, and add them to the connector pages the
    # extension frames for WebAuthn and Duo.
    vaultwarden:
      <<: *service
      rule: Host(`vault.{{ site.url }}`)
      service: vaultwarden@file
      middlewares: []
    # The websocket URL carries ?access_token=<JWT>, and Traefik can't redact a query
    # parameter, so keep these requests out of the access log (and the journal) entirely.
    vaultwarden-notifications:
      <<: *service
      rule: Host(`vault.{{ site.url }}`) && PathPrefix(`/notifications/`)
      service: vaultwarden@file
      middlewares: []
      observability:
        accessLogs: false
    # Authelia, then Vaultwarden's admin token
    vaultwarden-admin:
      <<: *service
      rule: Host(`vault.{{ site.url }}`) && PathPrefix(`/admin`)
      service: vaultwarden@file
      middlewares:
        - authelia@file
    olive_tin:
      <<: *service
      rule: Host(`command.{{ site.url }}`)
      service: olive_tin@file
  services:
    authelia:
      loadBalancer:
        servers:
          - url: https://auth.{{ site.url }}:9091/
        serversTransport: autheliaMutualTLS
    lldap:
      loadBalancer:
        servers:
          - url: http://ldap.{{ site.url }}:17170/
    gatus:
      loadBalancer:
        servers:
          - url: http://uptime.{{ site.url }}:8080/
    grafana:
      loadBalancer:
        servers:
          - url: http://graph.{{ site.url }}:3000/
    victoriametrics:
      loadBalancer:
        servers:
          - url: http://metrics.{{ site.url }}:8428/
    victorialogs:
      loadBalancer:
        servers:
          - url: http://logs.{{ site.url }}:9428/
    vmalert:
      loadBalancer:
        servers:
          - url: http://vmalert.{{ site.url }}:8880/
    alertmanager:
      loadBalancer:
        servers:
          - url: http://alert.{{ site.url }}:9093/
    ntfy:
      loadBalancer:
        servers:
          - url: http://push.{{ site.url }}:2586/
    ntfy-alertmanager:
      loadBalancer:
        servers:
          - url: http://ntfy-alertmanager.{{ site.url }}:2588/
    vaultwarden:
      loadBalancer:
        servers:
          - url: http://vault.{{ site.url }}:8080/
    olive_tin:
      loadBalancer:
        servers:
          - url: http://command.{{ site.url }}:1337/
    s403:
      loadBalancer:
        servers:
          - url: https://www.{{ site.url }}/error/403.html
