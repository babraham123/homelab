{% import 'src/nodes.jinja' as inv with context -%}
# /etc/opt/victoriametrics/prometheus.yml
# Ref: https://prometheus.io/docs/prometheus/latest/configuration/configuration
# Every target carries a `host` label (the node, no port): ntfy-alertmanager tags pushes
# by it, and it stays the same for every job on a node, except Gatus's endpoint series.
---
global:
  scrape_interval: 10s

scrape_configs:
  - job_name: 'authelia'
    static_configs:
      - targets: ['auth.{{ site.url }}:9959']
    metrics_path: /metrics
    relabel_configs: &host
      - target_label: host
        replacement: secsvcs
  - job_name: 'vmalert'
    static_configs:
      - targets: ['vmalert.{{ site.url }}:8880']
    metrics_path: /metrics
    relabel_configs: *host
  - job_name: 'victoriametrics'
    static_configs:
      - targets: ['metrics.{{ site.url }}:8428']
    basic_auth:
      username: 'admin'
      password: '%{VM_ADMIN_PASSWORD}'
    metrics_path: /metrics
    relabel_configs: *host
  - job_name: 'victorialogs'
    static_configs:
      - targets: ['logs.{{ site.url }}:9428']
    basic_auth:
      username: 'admin'
      password: '%{VL_ADMIN_PASSWORD}'
    metrics_path: /metrics
    relabel_configs: *host
  - job_name: 'fluentbit'
    static_configs:
      - targets: ['log-collector.{{ site.url }}:2020']
    metrics_path: /api/v1/metrics/prometheus
    relabel_configs: *host
  - job_name: gatus
    # https://github.com/TwiN/gatus?tab=readme-ov-file#metrics
    static_configs:
      - targets: ['uptime.{{ site.url }}:8080']
    metrics_path: /metrics
    relabel_configs: *host
    # Each endpoint's host is the node serving it, not the one running Gatus. Matched by
    # name, not group: the group is part of the key Gatus stores the history under.
    metric_relabel_configs:
{%- for node, endpoints in inv.uptime | groupby('node') %}
      - source_labels: [name]
        regex: '{{ endpoints | map(attribute='name') | join('|') }}'
        target_label: host
        replacement: {{ node }}
{%- endfor %}
  - job_name: 'crowdsec'
    # Engine and LAPI; cs_lapi_bouncer_requests_total shows each bouncer's pulls
    static_configs:
      - targets: ['crowdsec.{{ site.url }}:6060']
    metrics_path: /metrics
    relabel_configs: *host
  - job_name: 'crowdsec_appsec'
    # The node's WAF: requests inspected and blocked
    static_configs:
      - targets: ['appsec.{{ site.url }}:6060']
    metrics_path: /metrics
    relabel_configs: *host
  - job_name: 'ntfy'
    static_configs:
      - targets: ['push.{{ site.url }}:2587']
    metrics_path: /metrics
    relabel_configs: *host
  - job_name: 'traefik'
    static_configs:
      - targets: ['{{ inv.addr.secsvcs.traefik }}:8082']
    metrics_path: /metrics
    relabel_configs:
      - target_label: instance
        replacement: secproxy.{{ site.url }}
      - target_label: host
        replacement: secsvcs
  - job_name: 'node_exporter'
    static_configs:
      - targets:
          - host.containers.internal:9100
    metrics_path: /metrics
    relabel_configs:
      - target_label: instance
        replacement: secsvcs.{{ site.url }}:9100
      - target_label: host
        replacement: secsvcs
  - job_name: 'node_exporter_pve'
    static_configs:
      - targets: ['pve1.{{ site.url }}:9100']
    metrics_path: /metrics
    relabel_configs:
      - target_label: host
        replacement: pve1
...
