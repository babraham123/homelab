{% import 'src/nodes.jinja' as inv with context -%}
# /etc/opt/gatus/config.yaml
# Ref: https://github.com/TwiN/gatus?tab=readme-ov-file
---
metrics: true

web:
  port: 8080

storage:
  type: postgres
  path: "postgres://gatus@pgdb.{{ site.url }}:5432/gatus"

# PBS VM backups
maintenance:
  start: 01:00
  duration: 2h
  timezone: "{{ personal.timezone }}"
  every: [Sunday]

public-endpoint: &public
  group: public
  interval: 10m
  client:
    timeout: 10s
    dns-resolver: udp://1.1.1.1:53
  headers:
    User-Agent: "Mozilla/5.0 (gatus-robot; Linux x86_64)"
  conditions:
    - "[STATUS] == 200"
    - "[RESPONSE_TIME] < 1000"

internal-endpoint: &internal
  group: internal
  interval: 10m
  client:
    timeout: 10s
    dns-resolver: udp://1.1.1.1:53
    # https://www.authelia.com/integration/openid-connect/oauth-2.0-bearer-token-usage
    # https://www.authelia.com/integration/openid-connect/uptime-kuma/
    oauth2:
      # Don't use :9091, gatus uses external DNS
      token-url: https://auth.{{ site.url }}/api/oidc/token
      client-id: ${OIDC_CLIENT_ID}
      client-secret: ${OIDC_CLIENT_SECRET}
      scopes: ['authelia.bearer.authz']
  headers:
    User-Agent: "Mozilla/5.0 (gatus-robot; Linux x86_64)"
  conditions:
    - "[STATUS] == 200"
    - "[RESPONSE_TIME] < 1000"

endpoints:
  # - name: personal site
    # <<: *public
    # url: "https://{{ site.url }}"

  # Internal endpoints come from the uptime entries in src/nodes.yml
{% for endpoint in inv.uptime %}
  - name: {{ endpoint.name }}
    <<: *internal
    url: "{{ endpoint.url }}"
{% endfor %}

