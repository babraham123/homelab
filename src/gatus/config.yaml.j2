{% import 'src/nodes.jinja' as inv with context -%}
# /etc/opt/gatus/config.yaml
# Ref: https://github.com/TwiN/gatus?tab=readme-ov-file
---
metrics: true

web:
  port: 8080

storage:
  type: postgres
  path: "postgres://gatus@pgdb.{{ site.url }}:5432/gatus"

# The weekly backup run: src/pve1/backup_orchestrator.timer
maintenance:
  start: "02:00"
  duration: 3h
  timezone: "{{ personal.timezone }}"
  every: [Saturday]

public-endpoint: &public
  group: public
  interval: 10m
  client:
    timeout: 10s
    dns-resolver: udp://1.1.1.1:53
  headers:
    User-Agent: "Mozilla/5.0 (gatus-robot; Linux x86_64)"
  conditions:
    - "[STATUS] == 200"
    - "[RESPONSE_TIME] < 1000"
    # ACME renews at 30 days out, so this only fires once renewal has been failing.
    - "[CERTIFICATE_EXPIRATION] > 336h"

internal-endpoint: &internal
  group: internal
  interval: 10m
  client:
    timeout: 10s
    dns-resolver: udp://1.1.1.1:53
    # https://www.authelia.com/integration/openid-connect/oauth-2.0-bearer-token-usage
    # https://www.authelia.com/integration/openid-connect/uptime-kuma/
    oauth2:
      # Don't use :9091, gatus uses external DNS
      token-url: https://auth.{{ site.url }}/api/oidc/token
      client-id: ${OIDC_CLIENT_ID}
      client-secret: ${OIDC_CLIENT_SECRET}
      scopes: ['authelia.bearer.authz']
  headers:
    User-Agent: "Mozilla/5.0 (gatus-robot; Linux x86_64)"
  conditions:
    - "[STATUS] == 200"
    - "[RESPONSE_TIME] < 1000"
    # ACME renews at 30 days out, so this only fires once renewal has been failing.
    - "[CERTIFICATE_EXPIRATION] > 336h"

endpoints:
  # - name: personal site
    # <<: *public
    # url: "https://{{ site.url }}"

  # Internal endpoints come from the uptime entries in src/nodes.yml
{% for endpoint in inv.uptime %}
  - name: {{ endpoint.name }}
    <<: *internal
    url: "{{ endpoint.url }}"
{% endfor %}

  # Internal CA, year-long certs (src/certificates/self_signed_cert_gen.sh). LDAPS is
  # the one TLS-on-connect service without client-certificate auth: Postgres negotiates
  # TLS after connecting and Mosquitto requires a client certificate, so cert_notifier
  # covers those. No dns-resolver here: the container's resolver is the internal DNS.
  - name: lldap tls
    group: internal
    interval: 1h
    url: "tls://ldap.{{ site.url }}:6360"
    client:
      timeout: 10s
    conditions:
      - "[CONNECTED] == true"
      - "[CERTIFICATE_EXPIRATION] > 720h"

  # - name: jellyfin
    # <<: *internal
    # url: "https://media.{{ site.url }}"

  # - name: calibre
