# /etc/containers/systemd/node_exporter.container
# Ref: https://github.com/prometheus/node_exporter?tab=readme-ov-file#docker
# The VMs run node_exporter as a host binary (src/node_exporter/); the VPS runs the
# same thing as a quadlet so every service there installs the one way. Host network
# and PID namespace, the root filesystem read-only at /host, and nothing listening
# off loopback: the local vmagent scrapes it.

[Unit]
Description="Homelab: Track system level metrics"
StartLimitIntervalSec=30
StartLimitBurst=10
Wants=network.target
After=network-online.target

[Container]
Image=quay.io/prometheus/node-exporter:latest
ContainerName=node_exporter
AutoUpdate=registry
NoNewPrivileges=true

Network=host
PodmanArgs=--pid=host
# Root, for systemd's private socket; the image defaults to nobody.
User=0

# The unit filter is this node's services from src/nodes.yml, as node_runner.sh
# derives it from the "Homelab:" descriptions on the VMs.
Exec=--path.rootfs=/host \
     --web.listen-address=127.0.0.1:9100 \
     --collector.textfile.directory=/textfile \
     --collector.systemd \
     --collector.systemd.unit-include="({{ nodes.vpnsvcs.services.keys() | reject('eq', 'podman') | join('|') }})\.service"

Environment=TZ={{ personal.timezone }}

Volume=/:/host:ro,rslave
Volume=/run/systemd:/run/systemd:ro
Volume=/run/dbus:/var/run/dbus:ro
Volume=/var/lib/node_exporter/textfile_collector:/textfile:ro

[Service]
Restart=on-failure
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
