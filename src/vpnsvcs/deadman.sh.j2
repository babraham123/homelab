#!/bin/bash
# Watches the alerting path on secsvcs from outside it. Every alert ends in Alertmanager
# on secsvcs, so secsvcs down, Alertmanager down or vmalert stuck would notify nobody.
# vmalert evaluates a Watchdog rule that always fires (src/vmalert/configs/pipeline.yml)
# and Alertmanager routes it nowhere; this script looks for it through the API, and
# checks that ntfy answers, over the tailnet. After 3 failures in a row (15 minutes on
# the timer) it emails and pushes to a private topic on ntfy.sh, both independent of
# secsvcs, and once more on recovery. Any error counts as a failure: if the VPS or its
# tailnet link is down there is nothing it can say, and VpsMetricsAbsent covers that.
# Usage:
#   src/vpnsvcs/deadman.sh            # deadman.timer runs it every 5 minutes
# Needs, root-only files in /etc/opt/secrets/: alertmanager_admin_password,
# alert_smtp_password (the Alertmanager SMTP app password), deadman_ntfy_topic (a long
# random topic name the phone's ntfy app also subscribes to).

set -uo pipefail
export PATH=/usr/sbin:/usr/bin:/sbin:/bin

site="{{ site.url }}"
mail_to="{{ site.email.replace('@', '+alert@') }}"
smtp_user="{{ site.email }}"
secrets=/etc/opt/secrets
state=/var/lib/deadman
threshold=3

# Usage: notify PRIORITY TITLE BODY. ntfy priorities: https://docs.ntfy.sh/publish/#message-priority
notify() {
  local priority=$1 title=$2 body=$3
  curl -fsS -m 15 -H "Title: ${title}" -H "Priority: ${priority}" -H "Tags: rotating_light" \
    -d "$body" "https://ntfy.sh/$(cat "${secrets}/deadman_ntfy_topic")" > /dev/null ||
    echo "warning: ntfy.sh push failed" >&2
  printf 'From: Deadman <admin@%s>\nTo: %s\nSubject: %s\n\n%s\n' "$site" "$mail_to" "$title" "$body" |
    curl -fsS -m 30 --ssl-reqd --url smtp://smtp-relay.gmail.com:587 \
      --user "${smtp_user}:$(cat "${secrets}/alert_smtp_password")" \
      --mail-from "admin@${site}" --mail-rcpt "$mail_to" -T - ||
    echo "warning: email failed" >&2
}

install -d -m 700 "$state"
failure=""
if ! alerts=$(curl -fsS -m 15 -u "admin:$(cat "${secrets}/alertmanager_admin_password")" \
    "https://alert.${site}/api/v2/alerts?active=true&filter=alertname%3DWatchdog"); then
  failure="Alertmanager unreachable from the VPS: secsvcs, Alertmanager, Traefik or the tailnet is down"
elif [[ $(jq length <<< "$alerts") -lt 1 ]]; then
  failure="Watchdog alert missing: vmalert is not evaluating or not reaching Alertmanager"
elif ! curl -fsS -m 15 "https://push.${site}/v1/health" | jq -e .healthy > /dev/null; then
  failure="ntfy unhealthy: pushes from Alertmanager are not getting out"
fi

count=$(cat "${state}/failures" 2>/dev/null || echo 0)
if [[ -n $failure ]]; then
  count=$((count + 1))
  echo "$count" > "${state}/failures"
  echo "check failed (${count}/${threshold}): ${failure}" >&2
  if (( count == threshold )); then
    touch "${state}/firing"
    notify urgent "Homelab alerting is down" "$failure. Nothing routed through Alertmanager reaches you until this recovers."
  fi
else
  echo 0 > "${state}/failures"
  if [[ -e "${state}/firing" ]]; then
    rm -f "${state}/firing"
    notify default "Homelab alerting recovered" "Alertmanager shows the Watchdog alert and ntfy is healthy again."
  fi
fi
