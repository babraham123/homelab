# /etc/systemd/system/smartctl_exporter.service
# Ref: https://github.com/prometheus-community/smartctl_exporter

[Unit]
Description="Homelab: SMART metrics for the media array"
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
# Root for raw device access. Only the declared disks, so the VM's virtual disks aren't
# scanned; smartctl's default --nocheck=standby leaves a sleeping disk asleep, and the
# exporter logs that refusal (exit 2) as two warnings and an error per disk per scrape:
# the log level keeps the error only.
# Accessible at :9633/metrics
ExecStart=/usr/local/bin/smartctl_exporter \
{%- for d in websvcs.media.disks %}
  --smartctl.device=/dev/disk/by-id/{{ d.id }} \
{%- endfor %}
  --log.level=error \
  --web.listen-address=:9633
Restart=on-failure
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
