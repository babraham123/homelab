# /etc/systemd/system/snapraid-sync.service

[Unit]
Description="Homelab: snapraid sync of the media array"

[Service]
Type=oneshot
# Both jobs lock the content files: wait for the other to finish rather than fail on
# snapraid's own lock (Conflicts= would stop the running one instead)
ExecStart=/usr/bin/flock /run/snapraid.lock /usr/local/bin/snapraid_run.sh sync
Nice=10
IOSchedulingClass=idle
