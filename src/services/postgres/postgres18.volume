# /etc/containers/systemd/postgres18.volume
# Named for the major version: a new major starts on an empty volume and restores a dump into it
# Ref: https://docs.podman.io/en/latest/markdown/podman-systemd.unit.5.html#volume-units-volume

[Volume]
User=root
Group=root
# default: Driver=local
# /var/lib/containers/storage/volumes
