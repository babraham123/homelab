{% import 'src/nodes.jinja' as inv with context -%}
# /etc/opt/olive_tin/config/config.yaml
---
# Listen on all addresses available, port 1337
listenAddressSingleHTTPFrontend: 0.0.0.0:1337

# Choose from INFO (default), WARN and DEBUG
logLevel: "INFO"

# Ref: https://docs.olivetin.app/advanced_configuration/prometheus.html
# prometheus:
#   enabled: true
#   defaultGoMetrics: false

# Ref: https://docs.olivetin.app/security/oauth2_authelia.html
authRequireGuestsToLogin: true
authOAuth2RedirectURL: https://command.{{ site.url }}/oauth/callback
authOAuth2Providers:
  authelia:
    name: authelia
    title: Authelia
    clientID: {% raw %}${{ OLIVE_TIN_OIDC_ID }}{% endraw %}
    clientSecret: {% raw %}${{ OLIVE_TIN_OIDC_SECRET }}{% endraw %}
    authURL: https://auth.{{ site.url }}/api/oidc/authorization
    tokenURL: https://auth.{{ site.url }}/api/oidc/token
    whoamiUrl: https://auth.{{ site.url }}/api/oidc/userinfo
    scopes:
      - openid
      - profile
      - groups
    usernameField: preferred_username
    userGroupField: groups
    icon: <iconify-icon icon="simple-icons:authelia"></iconify-icon>

accessControlLists:
  - name: admins
    matchUsergroups:
      - command_admin
    permissions:
      view: true
      exec: true
      logs: true
    addToEveryAction: true
  - name: general
    matchUsergroups:
      - command_general
    permissions:
      view: true
      exec: true
      logs: false

# Deny unless an ACL grants it; admins get every action via addToEveryAction
defaultPermissions:
  view: false
  exec: false
  logs: false

defaultPolicy:
  showDiagnostics: true
  showLogList: true

defaultPopupOnStart: execution-dialog

# Ref: https://docs.olivetin.app/action_customization/intro.html
# Icons: https://docs.olivetin.app/action_customization/icons.html, https://iconify.design/

dashboards:
  - title: Main Dashboard
    contents:
      - title: General
        type: fieldset
        contents:
          - inlineAction:
              title: Date
              shell: date
              icon: date
              id: date
      - title: Gaming
        type: fieldset
        contents:
          - inlineAction:
              title: Start Gaming Server
              icon: <iconify-icon icon="maki:gaming"></iconify-icon>
              shell: ssh autoadmin@router start_pve2 && ssh autoadmin@pve2 start_gaming_vm && ssh autoadmin@gaming StartSunshine
              id: main_start_gaming
              maxConcurrent: 1
              acls: [general]
              timeout: 120
          - inlineAction:
              title: Stop Gaming Server
              icon: <iconify-icon icon="maki:gaming"></iconify-icon>
              shell: ssh autoadmin@pve2 stop_gaming_vm
              id: main_stop_gaming
              maxConcurrent: 1
              acls: [general]
              timeout: 60

  - title: All Commands
    contents:
{%- set icons = {'secsvcs': 'security', 'homesvcs': 'home', 'websvcs': 'cloud',
    'pve1': 'host-rounded', 'pve2': 'host-sharp', 'vpnsvcs': 'vpn-key', 'router': 'router',
    'gaming': 'videogame-asset', 'devtop': 'desktop-windows-outline'} %}
{%- for node, cmds in inv.buttons.items() if cmds %}
      - title: {{ node }}
        type: fieldset
        contents:
{% for cmd in cmds %}
          - inlineAction:
              title: {{ node }} {{ cmd | replace("_", " ") | title }}
              icon: <iconify-icon icon="material-symbols:{{ icons.get(node, 'dns') }}"></iconify-icon>
              shell: ssh autoadmin@{{ node }} {{ cmd }}
              id: {{ node }}_{{ cmd }}
              maxConcurrent: 1
              timeout: 60
{% endfor %}
{%- endfor %}
...
