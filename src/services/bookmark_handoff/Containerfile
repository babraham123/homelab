# bookmark-handoff's release zipapp, its libraries vendored in, which build.sh downloads
# into the build context.
FROM docker.io/library/python:3.15-alpine
# Nothing installs at run time, and pip's vendored urllib3 and msgpack would fail the scan
# gate.
RUN python3 -m pip uninstall -y pip
COPY bookmark_handoff /usr/local/bin/bookmark_handoff
ENTRYPOINT ["python3", "/usr/local/bin/bookmark_handoff"]
