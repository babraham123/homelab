{% import 'src/nodes.jinja' as inv with context -%}
# /etc/containers/systemd/bookmark_handoff.container
# Ref: https://docs.podman.io/en/latest/markdown/podman-systemd.unit.5.html
# A oneshot job, not a server: bookmark_handoff.timer runs it every 15 minutes. The image
# is babraham123/bookmark-handoff; its README documents the environment. It reaches
# linkding and Readeck on their container IPs, under their public host names, so Authelia
# isn't in the path; each app's own API token is. Tag names and paths are the image's
# defaults: toread, listen, tolisten, and the /books and /state mounts below.

[Unit]
Description="Homelab: Hands tagged bookmarks to Readeck, Calliope and yt_to_audiobook"
Wants=network-online.target
After=network-online.target linkding.service readeck.service
RequiresMountsFor=/srv/media

[Container]
Image=localhost/bookmark_handoff:latest
ContainerName=bookmark_handoff
AutoUpdate=local
NoNewPrivileges=true
DropCapability=all
ReadOnly=true

Network=net.network
IP={{ inv.addr.websvcs.bookmark_handoff }}

Environment=TZ={{ personal.timezone }}
Environment=LINKDING_URL=http://{{ inv.addr.websvcs.linkding }}:9090
Environment=LINKDING_HOST=archive.{{ site.url }}:9090
Environment=READECK_URL=http://{{ inv.addr.websvcs.readeck }}:8000
Environment=READECK_HOST=read.{{ site.url }}:8000
Secret=linkding_api_token,type=env,target=LINKDING_API_TOKEN
Secret=readeck_api_token,type=env,target=READECK_API_TOKEN

Volume=/var/opt/bookmark_handoff:/state
# Calliope's narrate/ and yt_to_audiobook's videos/ inboxes, and the readalouds they make
Volume=/srv/media/books:/books

[Service]
Type=oneshot
TimeoutStartSec=600
