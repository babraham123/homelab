# /etc/containers/systemd/esphome.container
# Ref: https://docs.podman.io/en/latest/markdown/podman-systemd.unit.5.html

[Unit]
Description="Homelab: ESPHome IoT device manager"
StartLimitIntervalSec=30
StartLimitBurst=10
Wants=network.target
After=network-online.target

[Container]
Image=localhost/esphome/esphome:2026.10.1
ContainerName=esphome
AutoUpdate=local
NoNewPrivileges=true
DropCapability=all
# No ReadOnly: PlatformIO writes its core dir under /root at compile time

# pve1 is a 4-core box that also runs pfSense: a compile pegs every core it's given for
# minutes. The memory limit is an estimate for an ESP32 (ESP-IDF) compile plus headroom;
# resize it from a measured peak.
PodmanArgs=--cpus=2
Memory=2g

Network=net.network
HostName=iot.{{ site.url }}
IP={{ inv.addr.homesvcs.esphome }}
# Dashboard: port 6052. No published ports: OTA (3232 ESP32, 8266 ESP8266, 2040 RP2040)
# and the native API (6053) are servers on the devices, so every connection goes out from
# here. No serial device either: the first flash runs over Web Serial in the browser.

Environment=TZ={{ personal.timezone }}
# WiFiIoT isn't in the mDNS bridge, so device status comes from ping
Environment=ESPHOME_DASHBOARD_USE_PING=true

# Device YAML, written by the dashboard
Volume=esphomeconfig.volume:/config
# Toolchains and build output, gigabytes that rebuild on the next compile; a separate
# volume keeps them out of the config volume's backup
Volume=esphomebuild.volume:/config/.esphome

[Service]
Restart=on-failure
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
