{
  "title": "Car",
  "uid": "car",
  "description": "Car Scanner recordings of the Kia EV6, imported by car_ingest on websvcs.",
  "editable": true,
  "schemaVersion": 39,
  "tags": [
    "car"
  ],
  "time": {
    "from": "now-14d",
    "to": "now"
  },
  "refresh": "",
  "templating": {
    "list": [
      {
        "name": "car",
        "label": "Car",
        "type": "query",
        "datasource": {
          "type": "victoriametrics-metrics-datasource"
        },
        "definition": "label_values(car_bms_battery_power, car)",
        "query": {
          "query": "label_values(car_bms_battery_power, car)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "trip",
        "label": "Trip",
        "type": "query",
        "datasource": {
          "type": "victoriametrics-metrics-datasource"
        },
        "definition": "label_values(car_bms_battery_power{car=\"$car\"}, trip)",
        "query": {
          "query": "label_values(car_bms_battery_power{car=\"$car\"}, trip)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 2,
        "sort": 2,
        "multi": true,
        "includeAll": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "datasource": {
        "type": "victoriametrics-metrics-datasource"
      },
      "id": 1,
      "title": "State of charge",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": 30000
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource"
          },
          "expr": "car_bms_state_of_charge_display{car=\"$car\", trip=~\"$trip\"}",
          "legendFormat": "display",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource"
          },
          "expr": "car_bms_state_of_charge_bms{car=\"$car\", trip=~\"$trip\"}",
          "legendFormat": "BMS",
          "refId": "B"
        }
      ]
    },
    {
      "datasource": {
        "type": "victoriametrics-metrics-datasource"
      },
      "id": 2,
      "title": "Battery power",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "kwatt",
          "custom": {
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": 30000
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource"
          },
          "expr": "car_bms_battery_power{car=\"$car\", trip=~\"$trip\"}",
          "legendFormat": "power",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": {
        "type": "victoriametrics-metrics-datasource"
      },
      "id": 3,
      "title": "Battery current",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "amp",
          "custom": {
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": 30000
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource"
          },
          "expr": "car_bms_battery_current{car=\"$car\", trip=~\"$trip\"}",
          "legendFormat": "current",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": {
        "type": "victoriametrics-metrics-datasource"
      },
      "id": 4,
      "title": "Battery voltage",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
