        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource"
          },
          "expr": "car_bms_cumulative_energy_charged{car=\"$car\", trip=~\"$trip\"}",
          "legendFormat": "charged",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource"
          },
          "expr": "car_bms_cumulative_energy_discharged{car=\"$car\", trip=~\"$trip\"}",
          "legendFormat": "discharged",
          "refId": "B"
        }
      ]
    },
    {
      "datasource": {
        "type": "victoriametrics-metrics-datasource"
      },
      "id": 8,
      "title": "12 V battery",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "volt",
          "custom": {
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": 30000
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource"
          },
          "expr": "car_bms_auxillary_battery_voltage{car=\"$car\", trip=~\"$trip\"}",
