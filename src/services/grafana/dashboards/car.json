          "expr": "car_bms_battery_cell_voltage_deviation{car=\"$car\", trip=~\"$trip\"}",
          "legendFormat": "deviation",
          "refId": "C"
        }
      ]
    },
    {
      "datasource": {
        "type": "victoriametrics-metrics-datasource"
      },
      "id": 6,
      "title": "Pack temperatures",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "custom": {
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": 30000
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource"
          },
          "expr": "{__name__=~\"car_bms_battery_pack_b[0-9]+\", car=\"$car\", trip=~\"$trip\"}",
          "legendFormat": "{{__name__}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource"
          },
          "expr": "car_bms_battery_min_temperature{car=\"$car\", trip=~\"$trip\"}",
          "legendFormat": "min",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource"
          },
          "expr": "car_bms_battery_max_temperature{car=\"$car\", trip=~\"$trip\"}",
          "legendFormat": "max",
          "refId": "C"
        },
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource"
          },
          "expr": "car_bms_battery_inlet_temperature{car=\"$car\", trip=~\"$trip\"}",
          "legendFormat": "inlet",
          "refId": "D"
        }
      ]
    },
    {
      "datasource": {
        "type": "victoriametrics-metrics-datasource"
      },
      "id": 7,
      "title": "Cumulative energy",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "kwatth",
          "custom": {
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": 30000
