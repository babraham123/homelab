        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource"
          },
          "expr": "car_bms_battery_dc_voltage{car=\"$car\", trip=~\"$trip\"}",
          "legendFormat": "pack",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": {
        "type": "victoriametrics-metrics-datasource"
      },
      "id": 5,
      "title": "Cell voltage",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "volt",
          "custom": {
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": 30000
          },
          "decimals": 3
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource"
          },
          "expr": "car_bms_minimum_cell_voltage{car=\"$car\", trip=~\"$trip\"}",
          "legendFormat": "min",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource"
          },
          "expr": "car_bms_maximum_cell_voltage{car=\"$car\", trip=~\"$trip\"}",
