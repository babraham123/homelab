    {
      "datasource": {
        "type": "victoriametrics-metrics-datasource"
      },
      "id": 9,
      "title": "Imported recordings",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 32
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource"
          },
          "expr": "max by (result) (car_ingest_files_total)",
          "legendFormat": "{{result}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value_and_name"
      }
    },
    {
      "datasource": {
        "type": "victoriametrics-metrics-datasource"
      },
      "id": 10,
      "title": "Last ingest run",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 32
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource"
          },
          "expr": "max(car_ingest_last_success_timestamp_seconds) * 1000",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeFromNow"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
