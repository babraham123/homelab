# /etc/opt/crowdsec/config/parsers/s02-enrich/homelab-allowlist.yaml
# Ref: https://docs.crowdsec.net/docs/next/log_processor/whitelist/format
# Events from these sources never reach a scenario, so they never become decisions.
# Banning the VPS's public or tailnet address would cut off all public traffic.
---
name: homelab/allowlist
description: "Never ban the homelab's own addresses"
whitelist:
  reason: "homelab address"
  ip:
    - "{{ vpnsvcs.ip }}"
  cidr:
{%- for cidr in inv.home_cidrs %}
    - "{{ cidr }}"
{%- endfor %}
...
