# /etc/opt/crowdsec/config/parsers/s02-enrich/homelab-whitelist.yaml
# Ref: https://docs.crowdsec.net/docs/next/log_processor/whitelist/format
# Events from these sources never reach a scenario, so they never become decisions.
# Banning the VPS's addresses or the router's (the source of tailnet traffic while it
# SNATs, router/04) would cut off all public traffic.
---
name: homelab/whitelist
description: "Never ban the homelab's own addresses"
whitelist:
  reason: "homelab address"
  ip:
    - "{{ vpnsvcs.ip }}"
  cidr:
    - "127.0.0.0/8"
    # Tailnet: `prefixes` in src/services/headscale/headscale.yaml.j2
    - "100.64.0.0/10"
    - "fd7a:115c:a1e0::/48"
    - "{{ lan.mask }}"
    - "{{ lan2.mask }}"
    - "{{ pve1.mask }}"
    - "{{ pve2.mask }}"
{%- for vlan in wifi.values() %}
    - "{{ vlan.mask }}"
{%- endfor %}
{%- for vlan in wired.values() %}
    - "{{ vlan.mask }}"
{%- endfor %}
{%- for node in [secsvcs, homesvcs, websvcs, vpnsvcs] %}
    - "{{ node.container_subnet }}.0/24"
{%- endfor %}
...
