# /etc/containers/systemd/alertmanager.container
# Ref: https://docs.podman.io/en/latest/markdown/podman-systemd.unit.5.html
# https://github.com/VictoriaMetrics/VictoriaMetrics/blob/master/deployment/docker/README.md

[Unit]
Description="Homelab: Sends alerting notifications"
StartLimitIntervalSec=30
StartLimitBurst=10
Wants=network.target
After=network-online.target

[Container]
Image=localhost/prom/alertmanager:latest
ContainerName=alertmanager
AutoUpdate=local
NoNewPrivileges=true
DropCapability=all
ReadOnly=true
# The *_file secrets below mount at /run/secrets/<name>, and runc can't create their
# mountpoints on the read-only root
Tmpfs=/run/secrets
HealthCmd=wget -q -O /dev/null http://admin:$${AM_ADMIN_PASSWORD}@127.0.0.1:9093/-/healthy
HealthInterval=30s
HealthRetries=3
HealthOnFailure=kill

Network=net.network
HostName=alert.{{ site.url }}
IP={{ inv.addr.secsvcs.alertmanager }}
# port 9093

Exec=--config.file="/config/config.yml" --web.config.file="/config/web_config.yml" \
     --web.external-url="https://alert.{{ site.url }}"

Environment=TZ={{ personal.timezone }}
Volume=/etc/opt/alertmanager:/config:ro
# Notification log and silences; without it a restart (every image update) forgets what
# was sent and pushes every firing alert again.
Volume=amdata.volume:/alertmanager
Secret=alertmanager_admin_password,type=env,target=AM_ADMIN_PASSWORD
# config.yml's *_file secrets, at /run/secrets/<name>
Secret=alert_smtp_password,type=mount
Secret=ntfy_alertmanager_admin_password,type=mount

[Service]
Restart=on-failure
TimeoutStartSec=300

# web_config.yml takes the admin password only as an inline bcrypt hash
ExecStartPre=/root/homelab-rendered/src/base/podman/render_secrets.sh /etc/opt/alertmanager/web_config.yml alertmanager_admin_password,bcrypt_salt
# User defined in the AM dockerfile
ExecStartPre=chown nobody:nogroup /etc/opt/alertmanager/web_config.yml

[Install]
WantedBy=multi-user.target
