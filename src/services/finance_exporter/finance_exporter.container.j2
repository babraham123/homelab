# /etc/containers/systemd/finance_exporter.container
# Ref: https://docs.podman.io/en/latest/markdown/podman-systemd.unit.5.html

[Unit]
Description="Homelab: export finance data to VictoriaMetrics"
StartLimitIntervalSec=30
StartLimitBurst=10
Wants=network.target
After=network-online.target

[Container]
Image=localhost/finance_exporter:latest
ContainerName=finance_exporter
AutoUpdate=local
NoNewPrivileges=true
DropCapability=all
ReadOnly=true
Tmpfs=/root/.cache

Network=net.network
HostName=finance-exporter.{{ site.url }}
IP={{ inv.addr.websvcs.finance_exporter }}
# port 8002

Environment=TZ={{ personal.timezone }}
{%- if ticker is defined and ticker.get('rates') %}
# config.yaml's fred source reads it
Secret=fred_api_key,type=env,target=FRED_API_KEY
{%- endif %}
Volume=/etc/opt/finance_exporter/config.yaml:/usr/src/app/finance-exporter.yaml:ro

[Service]
Restart=on-failure
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
