# /etc/containers/systemd/readeck.container
# Ref: https://docs.podman.io/en/latest/markdown/podman-systemd.unit.5.html

[Unit]
Description="Homelab: Readeck read-it-later reader"
StartLimitIntervalSec=30
StartLimitBurst=10
Wants=network.target
After=network-online.target

[Container]
Image=localhost/readeck/readeck:latest
ContainerName=readeck
AutoUpdate=local
NoNewPrivileges=true

Network=net.network
HostName=read.{{ site.url }}
IP={{ websvcs.container_subnet }}.18
# port 8000

Environment=TZ={{ personal.timezone }}
# Ref: https://readeck.org/en/docs/configuration
# config.toml is generated on first start with the secret key; these override it.
Environment=READECK_SERVER_BASE_URL=https://read.{{ site.url }}
Environment=READECK_TRUSTED_PROXIES={{ websvcs.container_subnet }}.6
# Ref: https://readeck.org/en/docs/external-auth
# Readeck overwrites a linked user's group from the IdP at every login, falling back
# to `user`: without the admin mapping the admin is demoted.
Environment=READECK_AUTH_OIDC_PROVIDERS_AUTHELIA_NAME=Authelia
Environment=READECK_AUTH_OIDC_PROVIDERS_AUTHELIA_URL=https://auth.{{ site.url }}
Environment="READECK_AUTH_OIDC_PROVIDERS_AUTHELIA_GROUPS=readeck_admin=admin authelia_gen_access=user"
Environment=READECK_AUTH_OIDC_PROVIDERS_AUTHELIA_PROVISIONING=true
Secret=readeck_oidc_id,type=env,target=READECK_AUTH_OIDC_PROVIDERS_AUTHELIA_CLIENT_ID
Secret=readeck_oidc_secret,type=env,target=READECK_AUTH_OIDC_PROVIDERS_AUTHELIA_CLIENT_SECRET

Volume=/var/opt/readeck:/readeck

[Service]
Restart=on-failure
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
