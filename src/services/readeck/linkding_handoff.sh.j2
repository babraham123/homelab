#!/bin/bash
# Sends linkding bookmarks tagged `toread` to Readeck, then swaps the tag for
# `readeck` so each is sent once. A bookmark whose handoff fails keeps `toread`, and
# the next run retries it. Run by linkding_handoff.timer.
# Usage:
#   src/services/readeck/linkding_handoff.sh

# shellcheck source=src/base/lib.sh
source "$(dirname "${BASH_SOURCE[0]}")/../../base/lib.sh"
# shellcheck source=src/services/readeck/handoff_lib.sh
source "${rendered}/services/readeck/handoff_lib.sh"

linkding=http://archive.{{ site.url }}:9090
readeck=http://read.{{ site.url }}:8000
resolve=(--resolve "archive.{{ site.url }}:9090:{{ websvcs.container_subnet }}.17"
  --resolve "read.{{ site.url }}:8000:{{ websvcs.container_subnet }}.18")
ld_auth="Token $(secret linkding_api_token)"
rd_auth="Bearer $(secret readeck_api_token)"
# linkding ids Readeck has accepted. Readeck's API can't look a bookmark up by URL, so
# this is what stops a retry after a failed retag from saving it twice.
sent=/var/lib/linkding_handoff/sent
mkdir -p "$(dirname "$sent")"
touch "$sent"

# All pages first: retagging while paging would shift the offsets.
bookmarks=()
url="${linkding}/api/bookmarks/?q=%23toread&limit=100"
while [[ -n $url ]]; do
  page=$(api GET "$url" "$ld_auth" "${resolve[@]}")
  mapfile -t -O "{% raw %}${#bookmarks[@]}{% endraw %}" bookmarks < <(jq -c '.results[]' <<< "$page")
  url=$(jq -r '.next // empty' <<< "$page")
done

failed=0
for bookmark in "${bookmarks[@]}"; do
  id=$(jq -r .id <<< "$bookmark")
  link=$(jq -r .url <<< "$bookmark")
  body=$(jq -c '{url, labels: (.tag_names - ["toread"])}
    + (if (.title // "") != "" then {title} else {} end)' <<< "$bookmark")
  if grep -qx "$id" "$sent"; then
    log "${link} (linkding ${id}) is already in Readeck; retagging only"
  elif api POST "${readeck}/api/bookmarks" "$rd_auth" "${resolve[@]}" \
      -H 'Content-Type: application/json' -d "$body" > /dev/null; then
    echo "$id" >> "$sent"
  else
    warn "Readeck refused ${link} (linkding ${id}); left tagged toread"
    failed=$((failed + 1))
    continue
  fi
  tags=$(jq -c '{tag_names: ((.tag_names - ["toread"]) + ["readeck"])}' <<< "$bookmark")
  if ! api PATCH "${linkding}/api/bookmarks/${id}/" "$ld_auth" "${resolve[@]}" \
      -H 'Content-Type: application/json' -d "$tags" > /dev/null; then
    warn "${link} is in Readeck, but retagging linkding ${id} failed; the next run retries it"
    failed=$((failed + 1))
    continue
  fi
  log "handed off ${link} (linkding ${id})"
done

(( failed == 0 )) || die "${failed} of {% raw %}${#bookmarks[@]}{% endraw %} handoffs failed"
