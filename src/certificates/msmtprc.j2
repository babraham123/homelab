# /etc/msmtprc
# Set default values for all following accounts.
defaults
port 587
tls on
tls_trust_file /etc/ssl/certs/ca-certificates.crt
logfile ~/.msmtp.log

account gmail
host smtp.gmail.com
from admin@{{ site.url }}
auth on
user {{ site.email }}
password "/root/homelab-rendered/src/pve1/msmtp_password.sh"

# Set a default account
account default : gmail
