# /etc/systemd/system/net_probe.service

[Unit]
Description="Homelab: Pings, speed test and iperf3 across the network"
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot

# Slot hours are local time
Environment=TZ={{ personal.timezone }}

# The script is pinned by install_svcs.sh net_probe; the config is read in place, so a
# deploy updates it
ExecStart=/usr/local/bin/net_probe --config /root/homelab-rendered/src/base/net_probe/config.json

# A run with every test due takes about two minutes
TimeoutStartSec=10min
