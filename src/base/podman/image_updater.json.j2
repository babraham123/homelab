{% import 'src/nodes.jinja' as inv with context -%}
{#- The image updater's config (github.com/babraham123/podman-image-updater, format in its
    README): one hosts entry per node with install_image_updater, its images in update
    order (src/nodes.jinja images[node]), each with its service's .trivyignore and, for a
    built image, its build.sh (tools/check_rendered.py requires one). install_svcs.sh
    image_updater links /etc/image_updater/config.json here, so a deploy updates it.
    deadline_s: no image is started after 25 minutes, so the run stays inside its 30-minute
    slot (image_updater.timer); what's left runs the next night. The notification path runs
    on secsvcs, its slot is last, and nothing has to fit after it. -#}
{%- set src = '/root/homelab-rendered/src/' -%}
{%- macro secret(name) -%}
{"command": {{ [src ~ 'base/podman/get_secret.sh', name] | tojson }}}
{%- endmacro -%}
{
  "registry_auth": {
    "docker.io": {
      "username": {{ secret('docker_hub_username') }},
      "password": {{ secret('docker_hub_token') }}
    }
  },
  "hosts": {
{%- for node in inv.nodes_with.install_image_updater %}
    {{ node | tojson }}: {
      "images": [
{%- for i in inv.images[node] %}
{%- set entry = dict(i, trivyignore=src ~ 'services/' ~ i.service ~ '/.trivyignore') %}
{%- if i.build is defined %}
{%- do entry.update({'build_script': src ~ 'services/' ~ i.service ~ '/build.sh'}) %}
{%- endif %}
        {{ entry | tojson }}{{ "," if not loop.last }}
{%- endfor %}
      ],
{%- if node == 'secsvcs' %}
{#- Straight to the container: no DNS, Traefik or TLS between the updater and ntfy while
    their images update. IP: ntfy.container. A catch-up run after a pve1 reboot waits for
    ntfy and the rest to settle. #}
      "ntfy": {"url": "http://{{ secsvcs.container_subnet }}.13:2586/alert", "token": {{ secret('ntfy_alert_token') }}},
      "deadline_s": 0,
      "boot_delay_s": 900
{%- else %}
{#- Container subnets are local to each node, so ntfy is reached through Traefik. #}
      "ntfy": {"url": "https://push.{{ site.url }}/alert", "token": {{ secret('ntfy_alert_token') }}},
      "deadline_s": 1500,
      "boot_delay_s": 0
{%- endif %}
    }{{ "," if not loop.last }}
{%- endfor %}
  }
}
