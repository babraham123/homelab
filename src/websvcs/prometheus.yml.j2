# /etc/opt/vmagent/prometheus.yml
# Ref: https://prometheus.io/docs/prometheus/latest/configuration/configuration
# Every target carries a `host` label (the node, no port): ntfy-alertmanager tags pushes
# by it, and it stays the same for every job on a node.
---
global:
  scrape_interval: 10s

scrape_configs:
  - job_name: 'vmagent'
    static_configs:
      - targets: ['metric-collector.{{ site.url }}:8429']
    metrics_path: /metrics
    relabel_configs: &host
      - target_label: host
        replacement: websvcs.{{ site.url }}
  - job_name: 'fluentbit'
    static_configs:
      - targets: ['log-collector.{{ site.url }}:2020']
    metrics_path: /api/v1/metrics/prometheus
    relabel_configs: *host
#   - job_name: 'finance_exporter'
#     static_configs:
#       - targets: ['finance-exporter.{{ site.url }}:8002']
#     metrics_path: /
#     relabel_configs: *host
  - job_name: 'node_exporter'
    static_configs:
      - targets:
          - host.containers.internal:9100
    metrics_path: /metrics
    relabel_configs:
      - target_label: instance
        replacement: websvcs.{{ site.url }}:9100
      - target_label: host
        replacement: websvcs.{{ site.url }}
  - job_name: 'node_exporter_pve'
    static_configs:
      - targets: ['pve2.{{ site.url }}:9100']
    metrics_path: /metrics
    relabel_configs:
      - target_label: host
        replacement: pve2.{{ site.url }}
...
