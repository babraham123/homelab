#!/bin/bash
# Runs the checks (tools/lib.sh run_checks) on the staged tree, rendered against
# vars.template.yml. If everything passes, the render replaces rendered/ and is staged
# with the commit. tools/check.sh runs the same checks on the working tree.
# Activate with: git config core.hooksPath .githooks (relative or absolute)
# Skip once with: git commit --no-verify

set -uo pipefail

# Git runs hooks from the root of the committing worktree. An absolute core.hooksPath
# points every worktree at one checkout's copy, so hand off to this worktree's own, and
# each branch runs its own hook.
repo=$(pwd)
if [ "$(cd "$(dirname "$0")" && pwd -P)" != "$(cd .githooks 2>/dev/null && pwd -P)" ]; then
  [ -x .githooks/pre-commit ] || { echo "pre-commit: ${repo}/.githooks/pre-commit is missing" >&2; exit 1; }
  exec .githooks/pre-commit "$@"
fi

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

# The index, not the working tree, is what gets committed.
git checkout-index --all --prefix="${tmp}/src/"
cd "${tmp}/src" || exit 1
# shellcheck source=tools/lib.sh
source tools/lib.sh

run_checks "${tmp}/rendered" || {
  echo "pre-commit: checks failed (paths are relative to the repo root)" >&2
  exit 1
}

# Agent instructions and repo-level files aren't templates; copies would only mislead.
out="${repo}/rendered"
rm -rf "$out"
cp -R "${tmp}/rendered" "$out"
rm -rf "${out:?}"/{.claude,.githooks,AGENTS.md,CLAUDE.md,LICENSE,README.md}
cat > "${out}/README.md" <<'README'
# Rendered copy (generated)

Generated by `.githooks/pre-commit` from the committed tree with the example values in
`vars.template.yml`, so the Jinja in `src/`, `docs/` and `tools/` can be read as the
files the nodes get. Don't edit it: edit the templates and commit, and the hook
regenerates it. Files still ending in `.j2` get their second render pass on the node
at service start (see docs/development.md).
README
git -C "$repo" add --all rendered
