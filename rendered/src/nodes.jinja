{#- The node inventory is one src/nodes/<node>/inventory.yml per node; render_src.sh
    assembles them, in node-name order, into vars.yml's `nodes` key. See
    docs/adr/0006-node-inventory.md.

    Per node, all keys optional:
      debian_services: src/base/debian/install_svcs.sh cases, dispatched as install_<name>
      services:        src/nodes/<node>/install_svcs.sh cases, dispatched as install_<name>.
                       Key order is install order. Per service, all optional:
                         subdomain:   host its Traefik router answers on
                         uptime:      Gatus endpoint name (keys its history); monitors
                                      https://<subdomain>.<site.url><uptime_path>
                         uptime_path: default ""
                         uptime_tier: 1 checks every 2 minutes instead of 10 (the
                                      proxies, login, and what you'd open first)
                         uptime_conditions: extra Gatus conditions, appended to the
                                      anchor's (status, latency, cert expiry)
                         upstream:    pulled image, full ref with registry host and
                                      namespace (docker.io/library/nginx:stable); the
                                      quadlet's Image= must be localhost/ + the ref
                                      without its host
                         build:       built image name; Image= must be localhost/<build>:latest
                         update_last: true moves the image to the end of the update run
                         containers:  {<quadlet name>: {upstream | build, update_last}}, in
                                      place of the keys above, when the case installs
                                      other quadlets than <service>.container
      install_all_svcs: true adds install_all_svcs, installing `services` in order
      commands:        other dispatcher cases, in order. Either
                         {name, script}: runs `sudo <script> <name>`; script is under src/;
                                         `sudo: false` drops the sudo
                         {name, run}:    runs these lines verbatim
      triggers:        gaming only: Dispatcher.ps1 whitelist

    This file derives lists from it, keyed by node. Not a .j2, so it is only imported:
      {% import 'src/nodes.jinja' as inv with context %}
    dispatch[node]:   dispatcher cases, [{name, run: [line, ...]}], in case order
    cases(node):      those cases as dispatcher.sh `case` text
    commands[node]:   case names (OliveTin buttons)
    sudo_cmds[node]:  sorted commands the dispatcher runs with sudo (sudoers)
    subdomains[node]: sorted subdomains its Traefik serves (Unbound, HAProxy)
    uptime:           Gatus internal endpoints, [{name, host, url, tier, conditions}]
    images[node]:     container images in update order (install order, update_last
                      entries last), [{service, container, image, upstream | build}] -#}
{%- set dispatch = {} -%}
{%- set commands = {} -%}
{%- set sudo_cmds = {} -%}
{%- set subdomains = {} -%}
{%- set uptime = [] -%}
{%- set images = {} -%}

{%- macro path(node, script) -%}
{#- upload_src.sh ships only src/nodes/router to the router, as /root/router-src -#}
{{- script | replace('nodes/router/', '/root/router-src/', 1) if node == 'router'
    else '/root/homelab-rendered/src/' ~ script -}}
{%- endmacro -%}

{%- for node, spec in nodes.items() -%}
  {%- set services = spec.get('services', {}) -%}
  {%- set entries = [] -%}
  {%- for svc in spec.get('debian_services', []) -%}
    {%- do entries.append({'name': 'install_' ~ svc,
        'run': ['sudo ' ~ path(node, 'base/debian/install_svcs.sh') ~ ' ' ~ svc]}) -%}
  {%- endfor -%}
  {%- set install_all = [] -%}
  {%- for svc in services -%}
    {%- do install_all.append('sudo ' ~ path(node, 'nodes/' ~ node ~ '/install_svcs.sh') ~ ' ' ~ svc) -%}
    {%- do entries.append({'name': 'install_' ~ svc, 'run': [install_all[-1]]}) -%}
  {%- endfor -%}
  {%- if spec.get('install_all_svcs', false) -%}
    {%- do entries.append({'name': 'install_all_svcs', 'run': install_all}) -%}
  {%- endif -%}
  {%- for cmd in spec.get('commands', []) -%}
    {%- if cmd.run is defined -%}
      {%- do entries.append({'name': cmd.name, 'run': cmd.run}) -%}
    {%- else -%}
      {%- do entries.append({'name': cmd.name,
          'run': [('sudo ' if cmd.get('sudo', true) else '') ~ path(node, cmd.script) ~ ' ' ~ cmd.name]}) -%}
    {%- endif -%}
  {%- endfor -%}
  {%- for trigger in spec.get('triggers', []) -%}
    {%- do entries.append({'name': trigger, 'run': []}) -%}
  {%- endfor -%}
  {%- do dispatch.update({node: entries}) -%}
  {%- do commands.update({node: entries | map(attribute='name') | list}) -%}

  {%- set sudo = [] -%}
  {%- for entry in entries -%}
    {%- for line in entry.run if line.startswith('sudo ') -%}
      {%- do sudo.append(line[5:]) -%}
    {%- endfor -%}
  {%- endfor -%}
  {%- do sudo_cmds.update({node: sudo | unique | sort}) -%}

  {%- do subdomains.update({node: services.values() | selectattr('subdomain', 'defined')
      | map(attribute='subdomain') | sort}) -%}
  {%- for svc in services.values() if svc.uptime is defined -%}
    {%- set host = svc.subdomain ~ '.' ~ site.url -%}
    {%- do uptime.append({'name': svc.uptime, 'host': host,
        'url': 'https://' ~ host ~ svc.get('uptime_path', ''),
        'tier': svc.get('uptime_tier', 2),
        'conditions': svc.get('uptime_conditions', [])}) -%}
  {%- endfor -%}

  {%- set first = [] -%}
  {%- set last = [] -%}
  {%- for name, svc in services.items() -%}
    {%- for container, c in svc.get('containers', {name: svc}).items()
        if c.upstream is defined or c.build is defined -%}
      {%- set entry = {'service': name, 'container': container} -%}
      {%- if c.upstream is defined -%}
        {%- do entry.update({'upstream': c.upstream,
            'image': 'localhost/' ~ c.upstream.split('/', 1)[-1]}) -%}
      {%- else -%}
        {%- do entry.update({'build': c.build, 'image': 'localhost/' ~ c.build ~ ':latest'}) -%}
      {%- endif -%}
      {%- do (last if c.get('update_last', false) else first).append(entry) -%}
    {%- endfor -%}
  {%- endfor -%}
  {%- do images.update({node: first + last}) -%}
{%- endfor -%}

{%- macro cases(node) -%}
  {%- set lines = [] -%}
  {%- for entry in dispatch[node] -%}
    {%- do lines.append('  ' ~ entry.name ~ ')') -%}
    {%- for line in entry.run -%}
      {%- do lines.append('    ' ~ line) -%}
    {%- endfor -%}
    {%- do lines.append('    ;;') -%}
  {%- endfor -%}
  {{- lines | join('\n') -}}
{%- endmacro -%}
