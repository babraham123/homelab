# /etc/systemd/system/image_updater.service

[Unit]
Description="Homelab: Checks, scans and applies container image updates"
Wants=network-online.target
After=network-online.target

[Service]
# Not oneshot: a oneshot start job fired during boot stays queued until the script ends,
# and the script waits for boot to finish. The script does its own boot wait.
Type=exec

Environment=TZ=America/Los_Angeles

ExecStart=/root/homelab-rendered/src/base/podman/image_updater.py

# Backstop only. The script stops starting images at its own deadline, since a killed
# podman auto-update can leave a unit stopped.
RuntimeMaxSec=90min
