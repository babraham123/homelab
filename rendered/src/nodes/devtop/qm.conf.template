# Proxmox VM settings (qm config) as a reference; IDs, MACs, UUIDs and PCI/USB addresses are placeholders
agent: 1
args: -vnc 127.0.0.1:22,password=on
bios: ovmf
boot: order=scsi0;net0
cores: 13
cpu: host
efidisk0: local-lvm:vm-VMID-disk-0,efitype=4m,pre-enrolled-keys=1,size=4M
hookscript: local:snippets/hookscript.pl
hostpci0: PCI_ADDR,pcie=1
machine: q35
memory: 16384
name: devtop
net0: virtio=MAC_ADDR,bridge=vmbr0,firewall=1
numa: 0
onboot: 1
ostype: l26
scsi0: local-lvm:vm-VMID-disk-1,discard=on,iothread=1,replicate=0,size=256G,ssd=1
scsihw: virtio-scsi-single
sockets: 1
vga: std,clipboard=vnc
