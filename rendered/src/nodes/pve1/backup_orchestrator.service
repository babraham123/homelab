# /etc/systemd/system/backup_orchestrator.service

[Unit]
Description="Homelab: Backs up the router locally, wakes pve2 and backs up every node to PBS"
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot

Environment=TZ=America/Los_Angeles

ExecStart=/root/homelab-rendered/src/nodes/pve1/backup_orchestrator.sh

# Bounds a hung ssh or vzdump; a full run is well under this.
TimeoutStartSec=6h
