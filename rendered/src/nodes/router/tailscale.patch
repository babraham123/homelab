+# wait for tailscaled to exit after a stop. rc.subr's own wait can give up while tailscaled is
+# still shutting down; a restart then finds the old daemon running, skips the start, and the
+# old process keeps its old environment (e.g. no TS_DEBUG_NETSTACK_SUBNETS after unchecking
+# SNAT). Kill it once the wait runs out so the start always applies the new settings.
+wait_for_tailscaled_exit() {
+	local _maxwaited="${1}"
+	local _waited=0
+
+	while tailscaled_running; do
+		if [ ${_waited} -ge ${_maxwaited} ]; then
+			logger -s -t tailscale "tailscaled still running after ${_maxwaited}s, killing it"
+			/bin/pkill -KILL -F /var/run/tailscaled.pid
+			sleep 1
+			break
+		fi
+		sleep 1
+		_waited=$((_waited+1))
+	done
+
+	tailscaled_not_running
+}
+
