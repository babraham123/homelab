# /etc/systemd/system/snapraid-sync.timer

[Unit]
Description="Homelab: Syncs snapraid parity daily"

[Timer]
# pve2 is off most of the time; Persistent runs a missed job at the next boot.
Persistent=true
OnCalendar=*-*-* 04:00:00
RandomizedDelaySec=10m
Unit=snapraid-sync.service

[Install]
WantedBy=timers.target
