# /etc/systemd/system/vm_watchdog.service

[Unit]
Description="Homelab: Restart VMs if they become unresponsive"
StartLimitIntervalSec=30
StartLimitBurst=10
Requires=pve-guests.service
# Stops before pve-guests shuts the VMs down, so it can't reset a guest mid-shutdown
# (backup_orchestrator powers pve2 off after every run).
After=pve-guests.service
Wants=network.target
After=network-online.target

[Service]
Type=simple

Environment=TZ=America/Los_Angeles

ExecStart=/usr/local/bin/vm_watchdog.sh

Restart=on-failure
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
