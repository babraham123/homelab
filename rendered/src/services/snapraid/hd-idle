# /etc/default/hd-idle
# The array's WD drives ship with no standby timer set. hd-idle times idleness from host I/O in
# /proc/diskstats, which smartctl_exporter's SMART polls don't count toward; a drive-side
# timer (hdparm -S) can be reset by every poll and never fire. -i 0 first leaves every other
# disk, the VM's virtual ones, alone.
HD_IDLE_OPTS="-i 0 -a /dev/disk/by-id/ata-WDC_WD80EFPX-68C4ZN0_WD-RD0000AA -i 900 -c ata -a /dev/disk/by-id/ata-WDC_WD80EFPX-68C4ZN0_WD-RD0000AB -i 900 -c ata -a /dev/disk/by-id/ata-WDC_WD80EFPX-68C4ZN0_WD-RD0000AC -i 900 -c ata -a /dev/disk/by-id/ata-WDC_WD80EFPX-68C4ZN0_WD-RD0000AD -i 900 -c ata"
