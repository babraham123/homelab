# car-ingest's release zipapp, which build.sh downloads into the build context, on Python's
# standard library. The base image carries the tzdata zoneinfo reads the phone's time zone
# from, and the CA certificates for an HTTPS VictoriaMetrics.
FROM docker.io/library/python:3.14-alpine
COPY car_ingest /usr/local/bin/car_ingest
ENTRYPOINT ["python3", "/usr/local/bin/car_ingest"]
