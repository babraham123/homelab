# /etc/systemd/system/readeck_narrate.timer

[Unit]
Description="Homelab: Runs readeck_narrate.service every 15 minutes"

[Timer]
# pve2 is off most of the time; Persistent runs a missed job at the next boot.
Persistent=true
OnCalendar=*:0/15
Unit=readeck_narrate.service

[Install]
WantedBy=timers.target
