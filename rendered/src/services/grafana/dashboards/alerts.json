{
  "annotations": {
    "list": []
  },
  "editable": true,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "id": 1,
      "title": "Firing alerts",
      "type": "table",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "${ds}"
          },
          "expr": "ALERTS{alertstate=\"firing\"}",
          "legendFormat": "__auto",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "options": {
        "sortBy": [
          {
            "displayName": "severity",
            "desc": true
          }
        ]
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "alertstate": true,
              "grafana_url": true,
              "vm_dash": true,
              "vg_dash": true,
              "va_dash": true
            },
            "indexByName": {
              "alertname": 0,
              "severity": 1,
              "instance": 2,
              "job": 3,
              "alertgroup": 4
            }
          }
        }
      ]
    },
    {
      "id": 2,
      "title": "node_exporter up",
      "type": "stat",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "${ds}"
          },
          "expr": "up{job=~\"node_exporter.*\"}",
          "legendFormat": "{{instance}}",
          "format": "time_series",
          "instant": true,
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "down"
                },
                "1": {
                  "text": "up"
                }
              }
            }
          ]
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Gatus endpoints",
      "type": "stat",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "${ds}"
          },
          "expr": "gatus_results_endpoint_success",
          "legendFormat": "{{name}}",
          "format": "time_series",
          "instant": true,
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "failing"
                },
                "1": {
                  "text": "ok"
                }
              }
            }
          ]
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Failed Homelab units",
      "type": "stat",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "${ds}"
          },
          "expr": "sum by (instance) (node_systemd_unit_state{state=\"failed\"})",
          "legendFormat": "{{instance}}",
          "format": "time_series",
          "instant": true,
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Certificate expiry (days)",
      "type": "bargauge",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 8,
        "y": 15,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "${ds}"
          },
          "expr": "gatus_results_certificate_expiration_seconds / 86400",
          "legendFormat": "{{name}}",
          "format": "time_series",
          "instant": true,
          "refId": "A"
        }
      ],
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 90,
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 14
              },
              {
                "color": "green",
                "value": 30
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "Disk free %",
      "type": "bargauge",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 16,
        "y": 15,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "${ds}"
          },
          "expr": "100 * node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay|squashfs|ramfs\"} / node_filesystem_size_bytes",
          "legendFormat": "{{instance}} {{mountpoint}}",
          "format": "time_series",
          "instant": true,
          "refId": "A"
        }
      ],
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 100,
          "decimals": 0,
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 10
              },
              {
                "color": "green",
                "value": 25
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "title": "Alerts firing over time",
      "type": "timeseries",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "${ds}"
          },
          "expr": "count by (alertname) (ALERTS{alertstate=\"firing\"})",
          "legendFormat": "{{alertname}}",
          "format": "time_series",
          "instant": false,
          "refId": "A"
        }
      ],
      "options": {},
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal"
            }
          },
          "decimals": 0
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "title": "pve2 temperatures",
      "type": "timeseries",
      "description": "CPU package/cores from pve2 node_exporter hwmon; GPUs from nvidia_gpu_exporter in the VM holding each card (P4: websvcs, 3060 Ti: devtop or gaming).",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "${ds}"
          },
          "expr": "max by (host) (node_hwmon_temp_celsius{host=\"pve2\", chip=~\"platform_coretemp_.*\"})",
          "legendFormat": "pve2 CPU",
          "format": "time_series",
          "instant": false,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "${ds}"
          },
          "expr": "nvidia_smi_temperature_gpu * on (uuid, instance) group_left (name) nvidia_smi_gpu_info",
          "legendFormat": "{{name}} ({{host}})",
          "format": "time_series",
          "instant": false,
          "refId": "B"
        }
      ],
      "options": {},
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "decimals": 0,
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "title": "Deployed commits",
      "description": "The commit each node's /root/homelab-rendered was rendered from (tools/render_src.sh, published by record_deploy.sh at upload). dirty counts uncommitted files. Informational: nothing alerts on drift.",
      "type": "table",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "${ds}"
          },
          "expr": "homelab_deployed_info",
          "legendFormat": "__auto",
          "format": "table",
          "instant": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "${ds}"
          },
          "expr": "homelab_deployed_timestamp_seconds * 1000",
          "legendFormat": "__auto",
          "format": "table",
          "instant": true,
          "refId": "B"
        }
      ],
      "options": {
        "sortBy": [
          {
            "displayName": "host",
            "desc": false
          }
        ]
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "rendered_at"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsIso"
              }
            ]
          }
        ]
      },
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value #A": true,
              "__name__": true,
              "instance": true,
              "job": true
            },
            "indexByName": {
              "host": 0,
              "sha": 1,
              "dirty": 2,
              "Value #B": 3
            },
            "renameByName": {
              "Value #B": "rendered_at"
            }
          }
        }
      ]
    }
  ],
  "refresh": "1m",
  "schemaVersion": 39,
  "tags": [
    "homelab"
  ],
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "includeAll": false,
        "label": "Datasource",
        "multi": false,
        "name": "ds",
        "options": [],
        "query": "victoriametrics-metrics-datasource",
        "refresh": 1,
        "regex": "",
        "type": "datasource"
      }
    ]
  },
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "",
  "title": "Homelab alerts",
  "uid": "homelab-alerts",
  "version": 1,
  "description": "Firing vmalert rules (src/services/vmalert/configs/homelab.yml, backups.yml) and the signals they watch."
}
