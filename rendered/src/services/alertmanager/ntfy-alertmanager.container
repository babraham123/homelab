# /etc/containers/systemd/alertmanager.container
# Ref: https://docs.podman.io/en/latest/markdown/podman-systemd.unit.5.html

[Unit]
Description="Homelab: Convert notifications from alertmanager to ntfy"
StartLimitIntervalSec=30
StartLimitBurst=10
Wants=network.target
After=network-online.target

[Container]
Image=docker.io/xenrox/ntfy-alertmanager:latest
ContainerName=ntfy-alertmanager
AutoUpdate=registry
NoNewPrivileges=true
DropCapability=all
ReadOnly=true
HealthCmd=curl -fsS -o /dev/null http://127.0.0.1:2588/health
HealthInterval=30s
HealthRetries=3
HealthOnFailure=kill

Network=net.network
HostName=ntfy-alertmanager.janedoe.com
IP=10.10.0.14
# port 2588

Exec=--config="/etc/ntfy-alertmanager/config.scfg"

Environment=TZ=America/Los_Angeles
Volume=/etc/opt/ntfy-alertmanager/config.scfg:/etc/ntfy-alertmanager/config.scfg:ro

[Service]
Restart=on-failure
TimeoutStartSec=300

ExecStartPre=/root/homelab-rendered/src/base/podman/render_secrets.sh /etc/opt/ntfy-alertmanager/config.scfg ntfy_alertmanager_admin_password,ntfy_alert_password,alertmanager_admin_password

[Install]
WantedBy=multi-user.target
