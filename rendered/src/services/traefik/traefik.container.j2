# /etc/containers/systemd/traefik.container
# Ref: https://docs.podman.io/en/latest/markdown/podman-systemd.unit.5.html
# Shared by the container VMs, rendered for each by base/podman/render_host.sh. A node's
# own additions are drop-ins in src/nodes/<node>/traefik/traefik.container.d/.

[Unit]
Description="Homelab: Traefik reverse proxy, main traffic entrypoint for {{ node }}"
StartLimitIntervalSec=30
StartLimitBurst=10
Wants=network.target
After=network-online.target

[Container]
Image=localhost/library/traefik:v3.7
ContainerName=traefik
AddCapability=CAP_NET_BIND_SERVICE
AutoUpdate=local
NoNewPrivileges=true

Network=net.network
HostName={{ services.traefik.subdomain }}.janedoe.com
IP={{ addr.traefik }}
# hostPort:containerPort
PublishPort=80:80
PublishPort=443:443

Exec="--configFile=/config/static/traefik.yml"

Environment=TZ=America/Los_Angeles
# The crowdsec middleware's key for AppSec, at /run/secrets/crowdsec_bouncer_key
Secret=crowdsec_bouncer_{{ node }},type=mount,target=crowdsec_bouncer_key
Volume=/etc/opt/traefik/config:/config
Volume=/etc/opt/traefik/certificates:/certificates
Volume=/etc/opt/traefik/plugins-local:/plugins-local:ro

[Service]
Restart=on-failure
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
