# /etc/containers/systemd/victorialogs.container
# Ref: https://docs.podman.io/en/latest/markdown/podman-systemd.unit.5.html
# https://github.com/VictoriaMetrics/VictoriaMetrics/blob/master/deployment/docker/README.md

[Unit]
Description="Homelab: Time series database and monitoring system"
StartLimitIntervalSec=30
StartLimitBurst=10
Wants=network.target
After=network-online.target

[Container]
Image=localhost/victoriametrics/victoria-logs:latest
ContainerName=victorialogs
AutoUpdate=local
NoNewPrivileges=true
DropCapability=all
ReadOnly=true

# http web front-end, ":9428/select/vmui"
Network=net.network
HostName=logs.janedoe.com
IP=10.10.0.8
# Syslog from pfSense, which sends from its address on this VM's subnet; ufw admits only that.
# Unprivileged port: the container drops every capability, NET_BIND_SERVICE included
PublishPort=5140:5140/udp

# https://docs.victoriametrics.com/victorialogs/#retention
# https://docs.victoriametrics.com/victorialogs/data-ingestion/syslog/
# Syslog streams drop the default proc_id: one stream per daemon, not per process
Exec=--storageDataPath="/storage" \
     --httpListenAddr=":9428" \
     --syslog.listenAddr.udp=":5140" \
     '--syslog.streamFields.udp=["hostname","app_name"]' \
     --retention.maxDiskSpaceUsageBytes="24GiB" \
     --retentionPeriod="14d" \
     --storage.minFreeDiskSpaceBytes="8GiB" \
     --memory.allowedBytes="512MiB" \
     --search.maxConcurrentRequests="3" \
     --httpAuth.username="admin" \
     --httpAuth.password="%{VL_ADMIN_PASSWORD}" \
     --loggerLevel="WARN" \
     --loggerTimezone="America/Los_Angeles"

Environment=TZ=America/Los_Angeles
Secret=victorialogs_admin_password,type=env,target=VL_ADMIN_PASSWORD
Volume=vldata.volume:/storage

[Service]
Restart=on-failure
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
